-- varka_cmd.script — v0.2 (+probe, has_order): творческий режим. Мост «наша игра → Anomaly» (20.10.2026)
--
-- Вьювер (tools/twin) шлёт команды серверу, сервер дописывает их строками в файл
-- ../appdata/logs/varka_cmd.txt, этот скрипт читает файл и исполняет новые строки.
-- Ответ идёт обратно через trace: cmd_ok / cmd_fail. Обратного канала другого нет.
--
-- Формат файла:
--   #session<TAB>id              — первая строка; новый id = сервер перезапущен, счёт с нуля
--   seq<TAB>команда<TAB>арг...   — команды; исполняем только seq больше последнего
--
-- Цели команд: "sq:<id>" — весь отряд, "npc:<id>" — один боец.
--
-- ПРИКАЗЫ двух сил (оба — свои действия в GOAP главного планировщика бойца):
--   мягкий  — «иди/стой, пока нет боя». Перебивает только прогулку симуляции (alife).
--             Появился враг или опасность — воюет как в обычной игре, потом возвращается.
--             Паттерн ванильного axr_beh (схема компаньонов).
--   жёсткий — «сквозь бой». Перебивает и бой, и опасность. Паттерн xrs_kill_wounded.
-- Приказ «идти» по прибытии превращается в «стоять» там же (той же силы).

local DEBUG     = true
local CMD_PATH  = "../appdata/logs/varka_cmd.txt"
local POLL_EVERY = 10       -- кадров между чтениями файла (кадры, а не time_global: под freeze_time время стоит)
local ARRIVE_SQR = 1.5 * 1.5
local SLOT_STEP  = 2.5      -- м между бойцами отряда вокруг точки приказа

local EVA_SOFT, ACT_SOFT = 188201, 188202  -- id в главном планировщике (рядом с xrs_kill_wounded 188112)
local EVA_HARD, ACT_HARD = 188203, 188204

local frame   = 0
local session = nil   -- id сессии сервера, которую уже читаем
local last_seq = 0

local squad_order = {}  -- [squad_id] = order
local npc_order   = {}  -- [npc_id]   = order (перекрывает отрядный)
local ghost_squad = {}  -- [squad_id] = true: нейтральны к актёру (зритель не лезет в бой)
local dir_order   = {}  -- [npc_id]   = order от дирижёра (пьесы вроде «засесть»); приказ игрока сильнее

-- order = { kind = "move"|"hold", vid, pos, hard, stamp }

-- varka_trace пишет строки как есть: кавычка или обратный слэш в тексте ошибки сломали бы JSON
local SPRINT_NEAR = 40   -- м: ближе к точке приказа спринт сменяется бегом со стволом наготове

local function emit(ev, f)
	if not varka_trace then return end
	for k, v in pairs(f) do
		if type(v) == "string" then f[k] = v:gsub("[\\\"]", "'"):gsub("[\r\n\t]", " ") end
	end
	varka_trace.emit(0, 0, ev, f)
end

local function split(line)
	local t = {}
	for part in string.gmatch(line, "[^\t]+") do t[#t+1] = part end
	return t
end

-- ============================================================================
-- ЦЕЛИ: "sq:123" / "npc:456" → список онлайн-бойцов
-- ============================================================================

local function squad_members_online(squad_id)
	local out = {}
	local squad = alife_object(squad_id)
	if not (squad and squad.squad_members) then return out end
	for k in squad:squad_members() do
		local o = level.object_by_id(k.id)
		if o and o:alive() then out[#out+1] = o end
	end
	return out
end

local function resolve(target)
	local kind, id = string.match(target or "", "^(%a+):(%d+)$")
	id = tonumber(id)
	if not id then return nil end
	if kind == "sq" then return "sq", id, squad_members_online(id) end
	if kind == "npc" then
		local o = level.object_by_id(id)
		return "npc", id, (o and o:alive()) and { o } or {}
	end
	return nil
end

local function player_order(npc)
	local o = npc_order[npc:id()]
	if o then return o end
	local squad = get_object_squad(npc)
	return squad and squad_order[squad.id] or nil
end

local function order_of(npc)
	return player_order(npc) or dir_order[npc:id()]
end

-- Есть ли у бойца приказ ИГРОКА. Приказ игрока сильнее пьес дирижёра (перегруппировка уступает).
function has_order(npc)
	return player_order(npc) ~= nil
end

-- Приказ дирижёра: жёстко (сквозь бой) в точную ноду и держать её. nil vid — снять.
-- Тот же станок, что у игрока: бегом без огня, на месте — огонь по видимому из укрытия.
-- look — куда смотреть на месте, пока врага не видно (сектор огня); гранате приказ уступает.
function set_dir_order(npc_id, vid, look)
	if not vid then dir_order[npc_id] = nil; return end
	local o = dir_order[npc_id]
	if o and o.vid == vid then o.look = look; return end  -- та же точка — не дёргать бойца заново
	dir_order[npc_id] = { kind = "move", vid = vid, pos = level.vertex_position(vid), hard = true,
		exact = true, look = look, stamp = time_global() }
end

-- Точка бойца внутри приказа отряда: первый — в центре, остальные кольцом по SLOT_STEP.
local function slot_vid(npc, order)
	if order.exact then return order.vid end  -- дирижёр сам раздал точки по бойцам
	local cache = db.storage[npc:id()]
	if not cache then return order.vid end
	if cache.varka_slot_stamp == order.stamp then return cache.varka_slot_vid end

	local idx = 0
	local squad = get_object_squad(npc)
	if squad and not npc_order[npc:id()] then
		local ids = {}
		for k in squad:squad_members() do ids[#ids+1] = k.id end
		table.sort(ids)
		for i, id in ipairs(ids) do if id == npc:id() then idx = i - 1 end end
	end

	local vid = order.vid
	if idx > 0 then
		local ring  = math.floor((idx - 1) / 6) + 1
		local angle = ((idx - 1) % 6) * 60 + ring * 30
		local dir = vector_rotate_y(vector():set(1, 0, 0), angle)
		local v = level.vertex_in_direction(order.vid, dir, SLOT_STEP * ring)
		-- 22.10: недоступную точку кольца НЕ меняем на центр — иначе все недоступные встают в одну ноду
		-- (ближайшую разрешённую к центру). Пусть каждый идёт к ближайшей разрешённой к СВОЕЙ точке.
		if v and v < 4294967295 then vid = v end
	end
	cache.varka_slot_stamp = order.stamp
	cache.varka_slot_vid   = vid
	return vid
end

-- Посты (23.10, юзер: «приехавшие на точку становятся на ближайшие посты, остальные как стояли»).
-- Пост = работа смарта (stalker_jobs, gulag): её нода alife_task — начало пути патруля/кемпера/снайпера
-- или смарт-кавер. Работы «в центре смарта» (их нода = нода самого смарта) — не посты.
-- Дошёл до своей точки → ближайший свободный пост в POST_R от точки приказа; не хватило — стоит где стоял.
local POST_R = 20
local POST_JOBS = { [9] = true, [11] = true, [12] = true }  -- gulag_general: охрана, снайпер, кемпер (не костёр/сон/анимточки)
local post_owner = {}  -- vid поста → id бойца

local function post_free(vid, id)
	local owner = post_owner[vid]
	if not owner or owner == id then return true end
	local o, st = level.object_by_id(owner), db.storage[owner]
	return not (o and o:alive() and st and st.varka_post == vid)
end

local function pick_post(npc, order)
	local center = level.vertex_position(order.vid)
	local sim, gg, here = alife(), game_graph(), level.name()
	local my = npc:position()
	local best, best_d
	for _, smart in pairs(SIMBOARD.smarts_by_names) do
		if smart.stalker_jobs and smart.position:distance_to(center) < POST_R + 80
			and sim:level_name(gg:vertex(smart.m_game_vertex_id):level_id()) == here then
			for _, job in ipairs(smart.stalker_jobs) do
				local task = POST_JOBS[job.job_type_id] and job.alife_task
				local vid = task and task:level_vertex_id()
				if vid and vid < 4294967295 and vid ~= smart.m_level_vertex_id then
					local p = level.vertex_position(vid)
					local d = p:distance_to(my)
					if p:distance_to(center) <= POST_R and (not best_d or d < best_d)
						and post_free(vid, npc:id()) and npc:accessible(vid) then
						best, best_d = vid, d
					end
				end
			end
		end
	end
	return best, best_d
end

-- ============================================================================
-- GOAP: оценщики «есть приказ» и действие «исполнять приказ»
-- ============================================================================

class "eva_varka_order" (property_evaluator)
function eva_varka_order:__init(name, hard) super(nil, name)
	self.hard = hard
end
function eva_varka_order:evaluate()
	local npc = self.object
	if not npc:alive() or IsWounded(npc) then return false end
	local o = order_of(npc)
	-- приказ дирижёра уступает гранате: пусть ваниль отбежит, потом приказ продолжится
	if o and o.exact and not player_order(npc) then
		local bd = npc:best_danger()
		if bd and bd:type() == danger_object.grenade then return false end
	end
	return o ~= nil and (o.hard == true) == self.hard
end

class "act_varka_order" (action_base)
function act_varka_order:__init(name, hard) super(nil, name)
	self.hard = hard
end

function act_varka_order:initialize()
	action_base.initialize(self)
	local npc = self.object
	if not npc:alive() then return end  -- v0.22: кадр смерти — трупом не командуем (краши 20.10)
	npc:set_path_type(game_object.level_path)
	db.storage[npc:id()].varka_order_active = true
	if varka_trace then
		varka_trace.emit(varka_lkp and varka_lkp.get_squad_key(npc) or 0, npc:id(), "order_start", { hard = self.hard })
	end
end

function act_varka_order:execute()
	action_base.execute(self)
	local npc = self.object
	if not npc:alive() then return end  -- v0.22: кадр смерти — трупом не командуем (краши 20.10)
	local o = order_of(npc)
	if not o then return end

	-- 22.10: точка приказа за ограничителем смарта (рестриктор) — движок ведёт к ближайшей РАЗРЕШЁННОЙ ноде,
	-- она у всех одна, и отряд встаёт кучей на краю (бой night_squads#210614-9: 300 с стояли в 75 м от зоны,
	-- ни выстрела; кадр «пятеро в одной точке в траве»). Приказ сильнее работы смарта: снимаем ограничители,
	-- и пересчитываем точки бойцов (их отбраковали как недоступные). Смена схемы смарта может вернуть
	-- ограничители — поэтому проверка каждый кадр, а запись в trace — раз на приказ.
	local st = db.storage[npc:id()]
	if st and not npc:accessible(o.vid) then
		if varka_trace and st.varka_unrestrict ~= o.stamp then
			varka_trace.emit(varka_lkp and varka_lkp.get_squad_key(npc) or 0, npc:id(), "order_blocked", {
				vid = o.vid, out = npc:out_restrictions() or "", inr = npc:in_restrictions() or "",
			})
		end
		st.varka_unrestrict = o.stamp
		npc:remove_all_restrictions()
		st.varka_slot_stamp = nil
	end

	-- пост действует, пока жив тот же приказ
	if st and st.varka_post_stamp ~= o.stamp then st.varka_post, st.varka_post_tried = nil, nil end
	if o.kind == "move" then o.went = true end
	local vid = (st and st.varka_post) or slot_vid(npc, o)
	local pos = level.vertex_position(vid)
	local far = npc:position():distance_to_sqr(pos) > ARRIVE_SQR
	-- 22.10: точка недоступна — «дошёл» = стоит на ближайшей разрешённой ноде (иначе вечно идёт на месте)
	if far and not npc:accessible(vid) then
		far = npc:accessible_nearest(pos, vector()) ~= npc:level_vertex_id()
	end

	if far then
		-- жёсткий — бегом без стрельбы; мягкий — шагом, ствол наготове. Шаг трассы (qmove) — свой темп и взгляд:
		-- не на конечную точку сквозь стены, а на место, которое стоит проверить
		local state = self.hard and "assault" or "raid"
		if not self.hard and o.approach == "run" then state = "assault" end
		if not self.hard and o.approach == "sprint" then
			state = npc:position():distance_to(o.pos) > SPRINT_NEAR and "sprint" or "assault"
		end
		if o.q then state = o.pace == "run" and "assault" or o.pace == "sneak" and "sneak" or "raid" end
		state_mgr.set_state(npc, state, nil, nil, { look_position = o.look_move or pos })
		utils_obj.send_to_nearest_accessible_vertex(npc, vid, "varka_order")
		return
	end

	if o.kind == "move" then
		o.kind = "hold"  -- дошли → стоим там же (та же сила приказа)
		if varka_trace then varka_trace.emit(varka_lkp and varka_lkp.get_squad_key(npc) or 0, npc:id(), "order_arrive", { vid = vid }) end
	end

	-- дошёл до точки по приказу «идти» (не стоянка у спавна, не точка дирижёра) — один раз ищем пост
	-- ваниль (varka_vanilla) поста не ищет: дошла — стоит наготове
	if st and o.went and not o.exact and st.varka_post_tried ~= o.stamp and not varka_vanilla.is(npc) then
		st.varka_post_tried, st.varka_post_stamp = o.stamp, o.stamp
		local post, d = pick_post(npc, o)
		if post then
			st.varka_post, post_owner[post] = post, npc:id()
			if varka_trace then
				varka_trace.emit(varka_lkp and varka_lkp.get_squad_key(npc) or 0, npc:id(), "order_post", { vid = post, d = d })
			end
			return  -- следующий кадр поведёт на пост
		elseif varka_trace then  -- поста нет (не хватило / у смарта нет охраны-снайперов-кемперов) — для счёта покрытия
			varka_trace.emit(varka_lkp and varka_lkp.get_squad_key(npc) or 0, npc:id(), "order_post", { vid = -1 })
		end
	end

	-- стоим: жёсткий держит пост и стреляет по видимому врагу; мягкий просто стоит наготове
	local be = npc:best_enemy()
	if self.hard and be and npc:see(be) then
		state_mgr.set_state(npc, (varka_aim.hold_state(npc, be)), nil, nil, { look_object = be })
	elseif self.hard then
		local look = (be and be:position()) or o.look
		state_mgr.set_state(npc, varka_aim.wait_state(npc), nil, nil, look and { look_position = look } or nil)
	elseif st and st.varka_post == vid then
		-- на посту — лицом наружу от точки приказа (простое «сторожим подходы», до квадрантов)
		local c = level.vertex_position(o.vid)
		local out = vector():set(pos.x - c.x, 0, pos.z - c.z)
		local look = out:magnitude() > 1 and vector():set(pos):add(out:normalize():mul(10)) or nil
		state_mgr.set_state(npc, "threat", nil, nil, look and { look_position = look } or nil)
	elseif o.q and o.look_move then
		-- дошёл до шага трассы — стоит наготове, ствол туда, куда велено смотреть
		state_mgr.set_state(npc, o.pace == "sneak" and "hide" or "threat", nil, nil, { look_position = o.look_move })
	else
		state_mgr.set_state(npc, "threat", nil, nil, nil)
	end
	utils_obj.send_to_nearest_accessible_vertex(npc, vid, "varka_order")
end

function act_varka_order:finalize()
	local npc = self.object
	varka_aim.release(npc)
	if db.storage[npc:id()] then db.storage[npc:id()].varka_order_active = nil end
	if varka_trace then
		varka_trace.emit(varka_lkp and varka_lkp.get_squad_key(npc) or 0, npc:id(), "order_end", { hard = self.hard })
	end
	action_base.finalize(self)
end

local function hook_npc(npc)
	local manager = npc:motivation_action_manager()
	if not manager then return end
	local wp = world_property

	manager:add_evaluator(EVA_SOFT, eva_varka_order("eva_varka_order_soft", false))
	manager:add_evaluator(EVA_HARD, eva_varka_order("eva_varka_order_hard", true))

	-- мягкий: только вне боя и опасности (как axr_beh)
	local soft = act_varka_order("act_varka_order_soft", false)
	soft:add_precondition(wp(stalker_ids.property_alive,  true))
	soft:add_precondition(wp(stalker_ids.property_enemy,  false))
	soft:add_precondition(wp(stalker_ids.property_danger, false))
	soft:add_precondition(wp(EVA_HARD, false))
	soft:add_precondition(wp(EVA_SOFT, true))
	soft:add_effect(wp(EVA_SOFT, false))
	manager:add_action(ACT_SOFT, soft)

	-- жёсткий: поверх всего (как xrs_kill_wounded)
	local hard = act_varka_order("act_varka_order_hard", true)
	hard:add_precondition(wp(stalker_ids.property_alive, true))
	hard:add_precondition(wp(EVA_HARD, true))
	hard:add_effect(wp(EVA_HARD, false))
	manager:add_action(ACT_HARD, hard)

	-- Кто должен уступать приказу. ВАЖНО: manager:action(id) ищет через lower_bound —
	-- спроси про id, которого у бойца нет, и получишь СОСЕДНЕЕ действие (условие повиснет
	-- не туда). Поэтому только действия, которые у сталкера есть всегда.
	local yield_soft = { xr_actions_id.alife, xr_actions_id.state_mgr + 2 }
	local yield_hard = { xr_actions_id.alife, xr_actions_id.state_mgr + 2,
		stalker_ids.action_combat_planner, stalker_ids.action_danger_planner }
	for _, id in ipairs(yield_soft) do
		manager:action(id):add_precondition(wp(EVA_SOFT, false))
	end
	for _, id in ipairs(yield_hard) do
		manager:action(id):add_precondition(wp(EVA_HARD, false))
	end
	-- добивание тоже уступает жёсткому приказу. Его действие есть не у всех: xrs_kill_wounded
	-- не регистрирует его зомбированным (и когда выключен в ltx) — тогда не трогаем.
	if xrs_kill_wounded and character_community(npc) ~= "zombied" and npc:section() ~= "actor_visual_stalker" then
		manager:action(xrs_kill_wounded.actid):add_precondition(wp(EVA_HARD, false))
	end
end

-- ============================================================================
-- КОМАНДЫ. Каждая: function(args) → true, "инфо" | false, "почему"
-- ============================================================================

local function vid_pos(vid)
	vid = tonumber(vid)
	if not (vid and vid < 4294967295) then return nil end
	return vid, level.vertex_position(vid)
end

local CMD = {}

-- Другие скрипты добавляют свои команды (varka_match: match_begin / match_abort)
function register(name, fn)
	CMD[name] = fn
end

-- Выполнить команду из другого модуля (сценарии): те же (ok, info), что у самой команды
function run_cmd(name, args)
	local fn = CMD[name]
	if not fn then return false, "нет такой команды" end
	return fn(args)
end

-- spawn <секция_отряда> <vid> <сколько> [ghost 1/0] [профиль бойца|-] [ранг|-] [гранат на бойца] [vanilla 1/0]
-- 25.10: vanilla = 1 — отряд «чистая ваниль» (varka_vanilla): VARKA его бойцов не трогает.
-- Бои «по рангам» (21.10): профиль = секция бойца sim_default_<группировка>_<0..4> (костюм),
-- ранг = число (новичок 1750, … легенда 30000). Снаряжение Anomaly выдаёт по рангу в момент
-- рождения (xrs_rnd_npc_loadout, колбэк se_stalker_on_spawn) — а ранг там ещё из профиля, случайный.
-- Поэтому выдачу на время спавна снимаем, ставим свой ранг и зовём её сами.
CMD.spawn = function(a)
	local section, vid, n, ghost = a[1], a[2], tonumber(a[3]) or 3, a[4] ~= "0"
	local member, rank = a[5] ~= "-" and a[5] or nil, tonumber(a[6])
	local gren = tonumber(a[7]) or 0   -- 24.10: РГД-5 каждому (у ванили граната у ~каждого пятого — гранаты v2 не увидеть)
	local pos
	vid, pos = vid_pos(vid)
	if not vid then return false, "плохой vid" end
	if not ini_sys:section_exist(section) then return false, "нет секции " .. tostring(section) end
	if member and not ini_sys:section_exist(member) then return false, "нет секции " .. member end
	local gvid = db.actor:game_vertex_id()

	local squad = alife_create(section, pos, vid, gvid)
	if not squad then return false, "alife_create не создал отряд" end

	-- состав: ровно n бойцов из npc_random секции (create_npc взял бы случайное число)
	local pool = member and { member } or parse_names(ini_sys:r_string_ex(section, "npc_random") or ini_sys:r_string_ex(section, "npc") or "")
	if #pool == 0 then return false, "у секции нет npc_random" end
	local sim = alife()
	local loadout = rank and xrs_rnd_npc_loadout and xrs_rnd_npc_loadout.on_creation
	if loadout then UnregisterScriptCallback("se_stalker_on_spawn", loadout) end
	local ranks = {}
	local ok, err = pcall(function()
		for i = 1, n do
			local id = squad:add_squad_member(pool[math.random(1, #pool)], pos, vid, gvid)
			local se = id and sim:object(id)
			if se then
				if rank then se:set_rank(rank) end
				if loadout then loadout(se) end  -- снаряжение по нашему рангу
				for _ = 1, gren do alife_create_item("grenade_rgd5", se) end
				ranks[#ranks + 1] = se:rank()
				SIMBOARD:setup_squad_and_group(se)
				SendScriptCallback("squad_on_npc_creation", squad, se)
			end
		end
	end)
	if loadout then RegisterScriptCallback("se_stalker_on_spawn", loadout) end  -- вернуть, даже если упали
	if not ok then return false, "спавн: " .. tostring(err) end
	local vanilla = a[8] == "1"
	if vanilla then varka_vanilla.mark_squad(squad) end  -- до выхода в онлайн: крючки встраиваются в первом npc_update
	if ghost then ghost_squad[squad.id] = true end
	-- по умолчанию отряд стоит, где родился (мягко: на бой реагирует)
	squad_order[squad.id] = { kind = "hold", vid = vid, pos = pos, hard = false, stamp = time_global() }
	emit("spawned", { sq = squad.id, section = section, n = n, vid = vid, member = member, ranks = table.concat(ranks, ","),
		vanilla = vanilla and 1 or 0 })
	return true, "sq:" .. squad.id
end

-- order <цель> <move|hold> <vid> <hard 1/0>
CMD.order = function(a)
	local kind, id = resolve(a[1])
	if not kind then return false, "плохая цель" end
	local vid, pos = vid_pos(a[3])
	if not vid then return false, "плохой vid" end
	-- 24.10: 5-й аргумент — темп подхода мягкого приказа: walk (raid, 2.5 м/с, как было) | run (assault, 4.5) |
	-- sprint (6.0, ствол за спиной; ближе SPRINT_NEAR к точке — уже assault, чтобы встреча не застала со стволом за спиной)
	local o = { kind = (a[2] == "hold") and "hold" or "move", vid = vid, pos = pos, hard = a[4] == "1", stamp = time_global(),
		approach = a[5] }
	if kind == "sq" then squad_order[id] = o else npc_order[id] = o end
	return true, kind .. ":" .. id
end

-- qmove <боец> <vid> <x> <y> <z> <run|walk|sneak> [метка] — шаг трассы квадрантов (23.10, match/conductor.py):
-- идти в ноду, глядя в точку x y z (место, которое стоит проверить взглядом), выбранным темпом. Мягкий: бой и
-- опасность главнее. Та же нода — только обновить взгляд и темп (не дёргать бойца). Метка — что нарисовать
-- вьюверу (номера площадок трассы), уходит в событие qmove.
CMD.qmove = function(a)
	local id = tonumber(a[1])
	local npc = id and level.object_by_id(id)
	if not (npc and npc:alive()) then return false, "нет бойца" end
	local vid, pos = vid_pos(a[2])
	if not vid then return false, "плохой vid" end
	local lx, ly, lz = tonumber(a[3]), tonumber(a[4]), tonumber(a[5])
	local look = lx and ly and lz and vector():set(lx, ly, lz) or nil
	local pace = (a[6] == "run" or a[6] == "sneak") and a[6] or "walk"
	local o = npc_order[id]
	if o and o.q and o.vid == vid then
		o.look_move, o.pace = look, pace
	else
		npc_order[id] = { kind = "move", vid = vid, pos = pos, hard = false, exact = true, q = true,
			look_move = look, pace = pace, stamp = time_global() }
	end
	if varka_trace and (not o or o.vid ~= vid or o.tag ~= a[7]) then
		varka_trace.emit(varka_lkp and varka_lkp.get_squad_key(npc) or 0, id, "qmove",
			{ vid = vid, lx = lx or 0, ly = ly or 0, lz = lz or 0, pace = pace, track = a[7] or "" })
	end
	npc_order[id].tag = a[7]
	return true, "npc:" .. id
end

-- free <цель> — снять приказы, отдать симуляции / дирижёру
CMD.free = function(a)
	local kind, id, list = resolve(a[1])
	if not kind then return false, "плохая цель" end
	if kind == "sq" then
		squad_order[id] = nil
		for _, o in ipairs(list) do npc_order[o:id()] = nil end
	else
		npc_order[id] = nil
	end
	return true, a[1]
end

-- preset <sq> <имя|off|default>
CMD.preset = function(a)
	local kind, id = resolve(a[1])
	if kind ~= "sq" then return false, "нужна цель sq:" end
	if not varka_director then return false, "дирижёра нет" end
	local name = a[2]
	if name == "default" then name = nil end
	if not varka_director.set_squad_preset(id, name) then return false, "нет пресета " .. tostring(name) end
	return true, a[1] .. " → " .. tostring(name or "default")
end

-- hostile <цель A> <цель B> — стравить: каждый из A враг каждому из B и наоборот
CMD.hostile = function(a)
	local ka, _, la = resolve(a[1])
	local kb, _, lb = resolve(a[2])
	if not (ka and kb) then return false, "плохая цель" end
	if #la == 0 or #lb == 0 then return false, "кто-то не в онлайне" end
	for _, x in ipairs(la) do
		for _, y in ipairs(lb) do
			x:set_relation(game_object.enemy, y)
			y:set_relation(game_object.enemy, x)
		end
	end
	return true, #la .. "×" .. #lb
end

-- attack <цель> <npc_id> — назначить врага (жёсткий приказ, если был, снимается)
CMD.attack = function(a)
	local kind, id, list = resolve(a[1])
	local victim = level.object_by_id(tonumber(a[2]) or -1)
	if not (kind and victim and victim:alive()) then return false, "плохая цель" end
	for _, o in ipairs(list) do
		npc_order[o:id()] = nil
		o:set_relation(game_object.enemy, victim)
		o:set_enemy(victim)
	end
	if kind == "sq" then squad_order[id] = nil end
	return true, #list .. " → " .. victim:id()
end

-- kill <цель> / remove <цель>
CMD.kill = function(a)
	local kind, _, list = resolve(a[1])
	if not kind then return false, "плохая цель" end
	for _, o in ipairs(list) do o:kill(o) end
	return true, #list .. " убито"
end

CMD.remove = function(a)
	local kind, id, list = resolve(a[1])
	if not kind then return false, "плохая цель" end
	if kind == "sq" then
		local squad = alife_object(id)
		if squad then
			for k in squad:squad_members() do alife_release_id(k.id, "varka_cmd remove") end
		end
		squad_order[id] = nil
	else
		alife_release_id(id, "varka_cmd remove")
	end
	return true, a[1]
end

-- time <множитель> — 1 норма, 0.2 слоу-мо, 3 ускорение
CMD.time = function(a)
	local f = tonumber(a[1])
	if not (f and f > 0) then return false, "нужно число > 0" end
	exec_console_cmd("time_factor " .. f)
	return true, tostring(f)
end

-- freeze <1|0> — заморозить мир (движковая freeze_time). Кадры идут, команды читаются.
CMD.freeze = function(a)
	exec_console_cmd("freeze_time " .. (a[1] == "1" and "on" or "off"))
	return true, a[1] == "1" and "on" or "off"
end

-- tp <vid> — перенести актёра (камеру-зрителя) к точке
-- 23.10: зрителя поставило в «Электру» (бой 011929-6) — вечные разряды мешают смотреть. Аномалии вокруг точки
-- берём с сервера (онлайн их ещё нет: игрок прыгает издалека), нода ближе ANOM_R к любой — ищем соседнюю кольцами.
local ANOM_R = 7
local function anomalies_near(pos, r)
	local out, sim = {}, alife()
	for id = 1, 65534 do
		local se = sim:object(id)
		if se and IsAnomaly(nil, se:clsid()) and se.position:distance_to(pos) < r then out[#out + 1] = se.position end
	end
	return out
end
local function safe_vid(vid)
	local pos = level.vertex_position(vid)
	local anoms = anomalies_near(pos, 40)
	if #anoms == 0 then return vid end
	local function ok(p)
		for _, a in ipairs(anoms) do if a:distance_to(p) < ANOM_R then return false end end
		return true
	end
	if ok(pos) then return vid end
	for r = 3, 30, 3 do
		for i = 0, 11 do
			local v = level.vertex_in_direction(vid, vector_rotate_y(vector():set(1, 0, 0), i * 30), r)
			if v and v < 4294967295 and v ~= vid and ok(level.vertex_position(v)) then return v end
		end
	end
	return vid
end

CMD.tp = function(a)
	local vid = vid_pos(a[1])
	if not vid then return false, "плохой vid" end
	vid = safe_vid(vid)
	db.actor:set_actor_position(level.vertex_position(vid))
	return true, tostring(vid)
end

-- level <имя_уровня> [смарт] — переехать на другой уровень, как быстрое перемещение ванили
-- (game_fast_travel). Без смарта — первый по алфавиту смарт уровня. Уровень грузится заново:
-- команды, лежавшие в файле до загрузки, там уже не исполнятся (first_update их пропускает).
CMD.level = function(a)
	local name, want = a[1], a[2]
	if not name then return true, level.name() end  -- без имени — где мы сейчас (матч «здесь»)
	local sim, gg = alife(), game_graph()
	local pick, se
	for sname, smart in pairs(SIMBOARD.smarts_by_names) do
		if sim:level_name(gg:vertex(smart.m_game_vertex_id):level_id()) == name
			and (not want or sname == want) and (not pick or sname < pick) then
			pick, se = sname, smart
		end
	end
	if not se then return false, "нет смарта " .. tostring(want or "") .. " на " .. tostring(name) end
	if name == level.name() then
		db.actor:set_actor_position(se.position)
	else
		ChangeLevel(se.position, se.m_level_vertex_id, se.m_game_vertex_id, VEC_ZERO, true)
	end
	return true, name .. " · " .. pick
end

-- cam <x> <y> <z> <tx> <ty> <tz> — камера деморекорда (demo_record) в точку, взгляд на цель.
-- Деморекорд не выключаем: тело игрока раннер переносит к бою (онлайн считается от тела),
-- а свободную камеру — сюда. Угол — как движок разбирает взгляд камеры (FDemoRecord.cpp):
-- heading = acos(dz) при dx<0, иначе 2π − acos(dz); pitch = asin(dy).
CMD.cam = function(a)
	local v = {}
	for i = 1, 6 do v[i] = tonumber(a[i]); if not v[i] then return false, "cam x y z tx ty tz" end end
	local d = vector():set(v[4] - v[1], v[5] - v[2], v[6] - v[3])
	local hz = vector():set(d.x, 0, d.z)
	if hz:magnitude() < 0.01 then hz = vector():set(0, 0, 1) end
	hz:normalize()
	local c = math.max(-1, math.min(1, hz.z))
	local h = (hz.x < 0) and math.acos(c) or (2 * math.pi - math.acos(c))
	d:normalize()
	local p = math.asin(math.max(-1, math.min(1, d.y)))
	exec_console_cmd(string.format("demo_set_cam_position %.2f,%.2f,%.2f", v[1], v[2], v[3]))
	exec_console_cmd(string.format("demo_set_cam_direction %.4f,%.4f,0", h, p))
	return true, "ok"
end

-- rel <группировка>... — отношения группировок, как их видит игра сейчас (не ltx: в Anomaly они
-- меняются по ходу игры). Ответ: "a>b:число;..." для каждой упорядоченной пары; ≤ -1000 — враги.
CMD.rel = function(a)
	local out = {}
	for _, x in ipairs(a) do
		for _, y in ipairs(a) do
			if x ~= y then
				out[#out + 1] = x .. ">" .. y .. ":" .. relation_registry.community_relation(x, y)
			end
		end
	end
	return true, table.concat(out, ";")
end

-- hour <0..23> — перевести часы игры вперёд до этого часа (как сон в ванили). Для серий матчей:
-- ночью бойцы почти слепые, и счёт меряет темноту, а не тактику.
CMD.hour = function(a)
	local h = tonumber(a[1])
	if not (h and h >= 0 and h < 24) then return false, "нужен час 0..23" end
	local cur = level.get_time_hours() + level.get_time_minutes() / 60
	local dh = (h - cur) % 24
	-- уже чуть позже нужного часа (10:12 при h = 10) — не крутим почти сутки вперёд
	if dh > 22 then return true, string.format("%.1f ~ %d, не трогаю", cur, h) end
	level.change_game_time(0, math.floor(dh), math.floor((dh % 1) * 60))
	return true, string.format("%.1f → %d", cur, h)
end

-- cvar <имя> [значение] — прочитать / выставить числовую консольную переменную ИИ (только ai_*).
-- Опыты над ванилью без перезапуска: раннер ставит перед серией и возвращает после.
-- Ответ «имя старое → новое», чтобы значение осталось в trace рядом с матчами.
CMD.cvar = function(a)
	local name, v = a[1], tonumber(a[2])
	if not (name and name:find("^ai_[%w_]+$")) then return false, "только ai_*" end  -- одно имя, без пробелов и хвостов
	local old = get_console():get_float(name)
	if v then exec_console_cmd(name .. " " .. string.format("%.4f", v)) end
	local new = get_console():get_float(name)
	-- незнакомое имя движок молча читает как 0 (21.10: ai_aim_fire_angle есть в engine_src, но не в exe 1.5.3)
	if v and math.abs(new - v) > 1e-3 then return false, name .. ": exe не знает такой команды" end
	return true, string.format("%s %.4f → %.4f", name, old, new)
end

-- quit — закрыть игру (ночной прогон: перед выключением компьютера, чтобы лог дописался)
CMD.quit = function(a)
	exec_console_cmd("quit")
	return true, "quit"
end

-- probe on|off|once — эхолот сверки зрения (varka_probe)
CMD.probe = function(a)
	if not varka_probe then return false, "нет varka_probe" end
	if a[1] == "once" then return varka_probe.snapshot(), "снимок" end
	varka_probe.set_enabled(a[1] == "on")
	return true, a[1] or "off"
end

-- ============================================================================
-- ЧТЕНИЕ ФАЙЛА КОМАНД
-- ============================================================================

local function run(seq, name, args)
	local fn = CMD[name]
	if not fn then
		emit("cmd_fail", { seq = seq, cmd = name, info = "нет такой команды" })
		return
	end
	local ok, res, info = pcall(fn, args)
	if varka_hud then varka_hud.push("cmd " .. name .. ((ok and res) and ": ok" or ": FAILED (reason in viewer log)")) end
	if not ok then
		emit("cmd_fail", { seq = seq, cmd = name, info = "ошибка Lua: " .. tostring(res) })
		printf("VARKA-CMD: %s #%s ERROR %s", name, seq, tostring(res))
	elseif res then
		emit("cmd_ok", { seq = seq, cmd = name, info = tostring(info or "") })
		if DEBUG then printf("VARKA-CMD: %s #%s ok %s", name, seq, tostring(info)) end
	else
		emit("cmd_fail", { seq = seq, cmd = name, info = tostring(info or "") })
		if DEBUG then printf("VARKA-CMD: %s #%s fail %s", name, seq, tostring(info)) end
	end
end

-- execute=false: только запомнить, докуда файл уже прочитан (старт игры — старые команды не исполняем)
local function poll(execute)
	local f = io.open(CMD_PATH, "r")
	if not f then return end
	local text = f:read("*a")
	f:close()
	if not text or text == "" then return end

	for line in string.gmatch(text, "[^\r\n]+") do
		local p = split(line)
		if p[1] == "#session" then
			if p[2] ~= session then
				session = p[2]
				last_seq = 0  -- сервер перезапущен: нумерация заново
			end
		else
			local seq = tonumber(p[1])
			if seq and seq > last_seq then
				last_seq = seq
				if execute then
					local args = {}
					for i = 3, #p do args[#args+1] = p[i] end
					run(seq, p[2], args)
				end
			end
		end
	end
end

local function actor_update()
	frame = frame + 1
	if frame % POLL_EVERY ~= 0 then return end
	poll(true)
end

local function first_update()
	poll(false)  -- что лежало в файле до загрузки — история, не исполняем
	printf("VARKA-CMD: ready, session=%s last_seq=%s", tostring(session), tostring(last_seq))
end

local function npc_update(npc)
	if not (npc and npc:alive() and IsStalker(npc)) then return end
	local id = npc:id()
	-- флаг в db.storage, а не в своей таблице: после офлайна боец приходит с новым
	-- планировщиком и новым storage — встраиваемся заново. Дважды в один планировщик нельзя
	-- (повторный add_evaluator с тем же id — падение движка).
	local st = db.storage[id]
	if not st or st.varka_cmd_hooked then return end
	st.varka_cmd_hooked = true
	hook_npc(npc)
	local squad = get_object_squad(npc)
	if squad and ghost_squad[squad.id] then
		npc:set_relation(game_object.neutral, db.actor)  -- зритель: отряд не воюет с актёром
	end
end

local function npc_death(npc)
	if npc then npc_order[npc:id()] = nil; dir_order[npc:id()] = nil end
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", first_update)
	RegisterScriptCallback("actor_on_update", actor_update)
	RegisterScriptCallback("npc_on_update", npc_update)
	RegisterScriptCallback("npc_on_death_callback", npc_death)
end
