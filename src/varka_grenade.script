-- varka_grenade.script — одна граната на отряд за раз (23.10.2026)
--
-- Бой night_squads#011929-3: экологи кинули три гранаты за 0.3 с (65.5–65.8 с) и четвёртую через 3 с. Юзер:
-- «прикольно, но бред». Ванильный запрет (stalker_property_evaluators.cpp, ShouldThrowGrenade): личный интервал
-- бойца и can_throw_grenade у агент-менеджера — тот сравнивает ТОЧКИ падения, а у троих они разные
-- (каждый кидает в свою память о враге).
-- Движок перед броском спрашивает Lua: _G.CAI_Stalker__ShouldThrow(npc) → false отменяет (крючок Modded Exes,
-- в exe есть, никем не занят). Отвечаем: в отряде уже кто-то кинул за последние SQUAD_MS — нельзя.
-- «Кто-то кинул» = первый, кому мы сказали «можно»; ему самому можно до конца его броска (крючок зовётся
-- каждый кадр, пока он решается).

local SQUAD_MS = 7000
local last = {}  -- id отряда → { id = кто кидает, t = когда ему разрешили }

local function squad_key(npc)
	local sq = get_object_squad(npc)
	return sq and sq.id or npc:id()
end

function should_throw(npc)
	local key, now = squad_key(npc), time_global()
	local l = last[key]
	if l and l.id ~= npc:id() and now - l.t < SQUAD_MS then return false end
	if not l or l.id ~= npc:id() or now - l.t >= SQUAD_MS then
		last[key] = { id = npc:id(), t = now }
		if varka_trace then varka_trace.emit(key, npc:id(), "grenade_ok", {}) end
	end
	return true
end

function on_game_start()
	_G.CAI_Stalker__ShouldThrow = should_throw
end
