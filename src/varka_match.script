-- varka_match.script — v0.1: матч в игре — граница, конец, итог (20.10.2026)
--
-- Матч целиком ведёт раннер tools/twin/match/run.py: спавнит отряды, стравливает, задаёт
-- дирижёра и приказ «к точке». Здесь — только то, что должна знать сама игра:
--   match_begin <id> <лимит, с> <vid точки> <радиус, м> <отряды A "sq,sq"> <отряды B>
--   match_abort
-- Раз в секунду: сколько живых у каждой стороны, кто держит точку (в радиусе только свои).
-- Конец: одна сторона выбита (eliminated) или вышло время (timeout) → событие match_end.
-- Оценку исхода считает tools/twin/match/score.py по trace — её формула меняется чаще игры.
--
-- Телеметрия всегда (и вне матча): death (кто кого) и hit (кто, кого, сколько, с какой дистанции,
-- видел ли раненый стрелка) — это датасет для модели попаданий двойника.
--
-- v0.4 (01.11.2026): спарринг «ты против ботов». Отряд "0" в стороне match_begin = игрок.
-- Смерть игрока в матче = нокаут: смерть отменяем (actor_on_before_death, как режим «Азазель»),
-- лечим, враги становятся нейтральны → следующий матч без загрузки сейва. Позиция и взгляд игрока
-- (камера) — в trace как npc_pos бойца 0, попадания по игроку — hit. 7-й арг. match_begin — смарт точки
-- (метка на карте/миникарте).
--
-- v0.5 (17.11.2026, после первых 5 боёв спарринга): перед боем игроку — снаряга (ремонт стволов в слотах,
-- патроны до KIT_MAGS магазинов текущего типа, аптечки/бинты до нормы), на экране — куда точка и сколько до неё;
-- нокаут — затемнение + надпись (раньше лечило молча, и было непонятно, что бой проигран), итог боя — надписью.

local TICK_MS = 1000

local match = nil  -- { id, limit, t0, zone, r, sides = { A = {sq=true}, B = {...} }, ctrl = {A=0,B=0}, next }

local function emit(sq, npc, ev, f)
	if varka_trace then varka_trace.emit(sq or 0, npc or 0, ev, f) end
end

local KO_GUARD_MS  = 20000   -- после нокаута/конца матча ещё столько игрок не может умереть
local ACTOR_POS_MS = 250     -- срез игрока чаще, чем у NPC (500): камера вертится быстро
local SPOT = "secondary_task_location"
local ko_until, actor_next = 0, 0

local function player_side(m)
	if not m then return nil end
	if m.sides.A[0] then return "A" end
	if m.sides.B[0] then return "B" end
end

local function heal_actor()
	db.actor:set_health_ex(1)
	db.actor.power = 1
	db.actor.radiation = 0
	db.actor.bleeding = 1           -- как gamemode_azazel.heal_everything: 1 = остановить кровь
	db.actor.psy_health = 1
	if arszi_psy and arszi_psy.set_psy_health then arszi_psy.set_psy_health(1.0) end
end

-- v0.5: снаряга на каждый бой — свои стволы, но полные: ремонт, патроны текущего типа, аптечки
local KIT_MAGS = 6
local KIT_MED  = { medkit = 3, bandage = 3 }

local function count_inv(sec, ammo)
	local n = 0
	db.actor:iterate_inventory(function(_, it)
		if it:section() == sec then n = n + (ammo and it:ammo_get_count() or 1) end
	end, db.actor)
	return n
end

local function give(sec, n)
	for _ = 1, n do alife_create_item(sec, db.actor) end
end

local function kit_actor()
	local a, got = db.actor, {}
	for _, slot in ipairs({ 2, 3 }) do
		local w = a:item_in_slot(slot)
		if w and IsWeapon(w) and not IsItem("fake_ammo_wpn", w:section()) then
			w:set_condition(1)
			local list = utils_item.get_ammo(w:section(), w:id())
			local ammo = list and list[(w:get_ammo_type() or 0) + 1]
			local mag = ini_sys:r_u32(w:section(), "ammo_mag_size") or 30
			if ammo and not got[ammo] then
				got[ammo] = true
				local need = mag * KIT_MAGS - count_inv(ammo, true)
				if need > 0 then
					create_ammo(ammo, a:position(), a:level_vertex_id(), a:game_vertex_id(), a:id(), need)
				end
			end
		end
	end
	for sec, n in pairs(KIT_MED) do
		local need = n - count_inv(sec)
		if need > 0 then give(sec, need) end
	end
end

local COMPASS = { "N", "NE", "E", "SE", "S", "SW", "W", "NW" }
local function where_is(p)   -- "85 m NE": x — восток, z — север
	local a = db.actor:position()
	local dx, dz = p.x - a.x, p.z - a.z
	local deg = math.deg(math.atan2(dx, dz)) % 360
	return string.format("%d m %s", math.floor(math.sqrt(dx * dx + dz * dz) + 0.5), COMPASS[math.floor((deg + 22.5) / 45) % 8 + 1])
end

local function say(text, sec)
	if actor_menu then actor_menu.set_msg(1, text, sec or 6) end
end

local function split_ids(s)
	local t = {}
	for x in string.gmatch(s or "", "%d+") do t[tonumber(x)] = true end
	return t
end

-- Живые бойцы стороны: всего (включая офлайн) и онлайн-позиции
local function side_members(sqs)
	local alive, online = 0, {}
	for sq in pairs(sqs) do
		local squad = sq ~= 0 and alife_object(sq)
		if sq == 0 then   -- игрок
			if db.actor:alive() and not (match and match.ko) then
				alive = alive + 1
				online[#online+1] = db.actor
			end
		elseif squad and squad.squad_members then
			for k in squad:squad_members() do
				local se = alife_object(k.id)
				if se and se:alive() then
					alive = alive + 1
					local o = level.object_by_id(k.id)
					if o and o:alive() then online[#online+1] = o end
				end
			end
		end
	end
	return alive, online
end

-- v0.3 (20.10, поиск краша): убийство убрано. Полигон по шагам: без уборки, с чисткой площадки и
-- с повторной чисткой — без крашей; с vanish (o:kill(o) живых + удаление) — краш тот же. Теперь
-- выживших не убиваем, а сразу отдаём ванильному безопасному удалению (сначала офлайн, потом
-- удалить): после конца матча врагов вокруг нет, и движку не за что держать бойца в онлайне.
local RELEASE_DELAY = 10000
local pending = {}  -- [id] = когда удалить (наследие v0.2; сейчас vanish ничего не откладывает)

local function vanish(id)
	local se = alife_object(id)
	if not se then return false end
	safe_release_manager.release(se)
	return true
end

local function release_pending()
	local now = time_global()
	for id, at in pairs(pending) do
		if now >= at then
			pending[id] = nil
			local se = alife_object(id)
			if se then safe_release_manager.release(se) end
		end
	end
end

-- После конца матча — без мародёрства. В бою подобрать ствол убитого нормально (ваниль как есть),
-- а после конца незачем: выживших скоро уберут. И опасно: ваниль при подборе бросает свой ствол того
-- же класса и уничтожает лишние патроны (on_after_take → update_conflicted) — в дампах крашей 20.10
-- цепочка шла через это событие, а наша уборка в те же секунды удаляет трупы и оружие.
local NO_LOOT = nil
local function no_loot(o)
	NO_LOOT = NO_LOOT or xr_logic.parse_condlist(db.actor, "varka_match", "no_loot", "false")
	o:take_items_enabled(false)
	local st = db.storage[o:id()]
	if not st then return end
	if st.corpse_detection then
		st.corpse_detection.corpse_detection_enabled = NO_LOOT
		st.corpse_detection.mutant_corpse_analysis = NO_LOOT
	end
	if st.gather_items then
		st.gather_items.gather_items_enabled = NO_LOOT
		st.gather_items.gather_artefact_items_enabled = NO_LOOT
	end
end

local function finish(reason)
	if not match then return end
	local now = time_global()
	local a, on_a = side_members(match.sides.A)
	local b, on_b = side_members(match.sides.B)
	for _, o in ipairs(on_a) do no_loot(o) end   -- выжившие больше ничего не подбирают
	for _, o in ipairs(on_b) do no_loot(o) end
	emit(0, 0, "match_end", { id = match.id, reason = reason, dur = (now - match.t0) / 1000,
		alive_a = a, alive_b = b, ctrl_a = match.ctrl.A, ctrl_b = match.ctrl.B })
	if varka_hud then varka_hud.push(string.format("MATCH %s over: %s (alive %d vs %d)", match.id, reason, a, b)) end
	local ps = player_side(match)
	if ps then
		local mine, theirs = (ps == "A") and a or b, (ps == "A") and b or a
		say(match.ko and "FIGHT LOST (knockout)" or (theirs == 0 and mine > 0) and "FIGHT WON"
			or reason == "timeout" and "FIGHT: time is up" or ("FIGHT over: " .. reason), 8)
		heal_actor()                                   -- следующий матч — с полным здоровьем
		ko_until = math.max(ko_until, now + KO_GUARD_MS)
		if match.spot then level.map_remove_object_spot(match.spot, SPOT) end
	end
	match = nil
end

local function actor_pos(now)
	if now < actor_next then return end
	actor_next = now + ACTOR_POS_MS
	local a = db.actor
	local p, d = a:position(), device().cam_dir
	local wi = a:active_item()
	emit(0, 0, "npc_pos", { px = p.x, py = p.y, pz = p.z, dx = d.x, dz = d.z, hx = d.x, hz = d.z, hy = d.y,
		comm = "actor", rank = a:character_rank(), hp = a.health, be = -1, bsee = 0,
		wpn = wi and wi:section() or "", mag = (wi and IsWeapon(wi) and wi:get_ammo_in_magazine()) or -1,
		cr = IsMoveState("mcCrouch") and 1 or 0, name = "PLAYER" })
end

local function tick()
	if next(pending) then release_pending() end
	if not match then return end
	local now = time_global()
	if player_side(match) and not match.ko then actor_pos(now) end
	if now < match.next then return end
	local dt = (now - match.next + TICK_MS) / 1000
	match.next = now + TICK_MS

	local a, on_a = side_members(match.sides.A)
	local b, on_b = side_members(match.sides.B)
	if a == 0 or b == 0 then return finish("eliminated") end

	-- точка: держит та сторона, чьи живые в радиусе, а чужих там нет
	local r2 = match.r * match.r
	local in_a, in_b = 0, 0
	for _, o in ipairs(on_a) do if o:position():distance_to_sqr(match.zone) < r2 then in_a = in_a + 1 end end
	for _, o in ipairs(on_b) do if o:position():distance_to_sqr(match.zone) < r2 then in_b = in_b + 1 end end
	if in_a > 0 and in_b == 0 then match.ctrl.A = match.ctrl.A + dt end
	if in_b > 0 and in_a == 0 then match.ctrl.B = match.ctrl.B + dt end

	if now - match.t0 > match.limit then finish("timeout") end
end

local function cmd_begin(a)
	if match then finish("replaced") end
	local id, limit, vid, r = a[1], tonumber(a[2]), tonumber(a[3]), tonumber(a[4])
	if not (id and limit and vid and r) then return false, "match_begin <id> <limit_s> <zone_vid> <r> <A> <B> [смарт]" end
	local sa, sb = split_ids(a[5]), split_ids(a[6])
	if next(sa) == nil or next(sb) == nil then return false, "empty side" end
	local now = time_global()
	match = { id = id, limit = limit * 1000, t0 = now, next = now + TICK_MS,
		zone = level.vertex_position(vid), r = r, sides = { A = sa, B = sb }, ctrl = { A = 0, B = 0 } }
	emit(0, 0, "match_start", { id = id, limit = limit, zx = match.zone.x, zz = match.zone.z, zr = r,
		a = a[5], b = a[6], level = level.name() })
	local smart = a[7] and SIMBOARD.smarts_by_names[a[7]]
	if player_side(match) and smart then   -- спарринг: точка матча — меткой на карте и миникарте
		match.spot = smart.id
		level.map_add_object_spot(smart.id, SPOT, "VARKA: match point")
	end
	if player_side(match) then
		-- 17.11: КПК (device_pda_3) рисует отряды, чья группировка тебе не враг (sim_squad_scripted:show) —
		-- боты матча враги лично, и игрок видел их на карте. Прячем метки отрядов матча.
		for sq in pairs(player_side(match) == "A" and sb or sa) do
			local squad = alife_object(sq)
			if squad and squad.hide then squad.show_disabled = true; squad:hide() end
		end
		kit_actor()
		say("FIGHT! Hold the point (" .. r .. " m): " .. where_is(match.zone) .. ". Gear refilled.", 10)
	end
	if varka_hud then varka_hud.push("MATCH " .. id .. " started") end
	return true, id
end

local function cmd_abort(a)
	if not match then return false, "no match" end
	finish("aborted")
	return true, "aborted"
end

-- clear <vid> <радиус> — убрать с площадки чужих: отряды без сюжетных меток, трупы и брошенное
-- на землю оружие/патроны/гранаты (иначе новички следующего матча подбирают стволы павших).
-- Сюжетных (story_id у отряда или бойца — Лукаш, торговцы, квестовые) не трогаем.
-- Только онлайн-окрестность: дальше радиуса сейв остаётся как был.
-- Трупы и вещи — через ванильный safe_release_manager: alife_release для мёртвого бойца без
-- отряда молча ничего не делает (полигон 20.10: трупов на площадке копилось 3 → 52).
-- Убрать бойца насовсем. Живого в онлайне ванильный путь (alife_release → safe_release_manager)
-- не берёт: в бою движок не отпускает его в офлайн, и он воюет дальше (полигон 20.10: пять
-- отрядов сейва пережили чистку). Поэтому живого сначала убиваем, потом труп — в очередь удаления.

-- vanish sq:<id> — отряд целиком (раннер убирает выживших после матча)
local function cmd_vanish(a)
	local id = tonumber(string.match(a[1] or "", "^sq:(%d+)$"))
	local squad = id and alife_object(id)
	if not (squad and squad.squad_members) then return true, "already gone" end
	local n = 0
	for k in squad:squad_members() do if vanish(k.id) then n = n + 1 end end
	return true, n .. " npc"
end

local function cmd_clear(a)
	local vid, r = tonumber(a[1]), tonumber(a[2]) or 150
	if not (vid and vid < 4294967295) then return false, "bad vid" end
	local keep = {}   -- a[3] = "sq,sq" — отряды матча, их не трогаем (повторная чистка перед стартом)
	for x in string.gmatch(a[3] or "", "%d+") do keep[tonumber(x)] = true end
	-- a[4] = "squads": только чужие отряды. Трупы и оружие не трогаем — рядом уже стоят бойцы матча,
	-- удалять вещи у них под ногами (они могут их подбирать) — тот же путь к крашу
	local squads_only = a[4] == "squads"
	local center = level.vertex_position(vid)
	local squads, corpses, items = {}, {}, {}
	level.iterate_nearest(center, r, function(o)
		if o:id() == AC_ID or get_object_story_id(o:id()) then return end
		if IsStalker(o) or IsMonster(o) then
			if not o:alive() then
				corpses[#corpses+1] = o:id()
			else
				local sq = get_object_squad(o)
				if sq and not keep[sq.id] then squads[sq.id] = sq end
			end
		elseif (IsWeapon(o) or IsAmmo(o) or IsGrenade(o)) and not o:parent() then
			items[#items+1] = o:id()   -- лежит на земле, ничей
		end
	end)
	local n_sq, n_c = 0, 0
	for id, sq in pairs(squads) do
		local story = get_object_story_id(id)
		for k in sq:squad_members() do story = story or get_object_story_id(k.id) end
		if not story then
			for k in sq:squad_members() do vanish(k.id) end
			n_sq = n_sq + 1
		end
	end
	local n_i = 0
	if squads_only then corpses, items = {}, {} end
	for _, list in ipairs({ corpses, items }) do
		for _, id in ipairs(list) do
			local se = alife_object(id)
			if se then
				safe_release_manager.release(se)
				if list == corpses then n_c = n_c + 1 else n_i = n_i + 1 end
			end
		end
	end
	emit(0, 0, "match_clear", { squads = n_sq, corpses = n_c, items = n_i, r = r })
	return true, n_sq .. " squads, " .. n_c .. " corpses, " .. n_i .. " items"
end

-- smarts — выгрузить в trace все смарт-террейны текущего уровня (имя, x, z, vid):
-- раннер берёт их как точки матчей — вся локация без ручного сбора координат
local function cmd_smarts(a)
	if not (SIMBOARD and SIMBOARD.smarts) then return false, "no SIMBOARD" end
	local gg = game_graph()
	local here = gg:vertex(db.actor:game_vertex_id()):level_id()
	local n = 0
	for _, v in pairs(SIMBOARD.smarts) do
		local sm = v.smrt
		if sm and gg:vertex(sm.m_game_vertex_id):level_id() == here then
			emit(0, 0, "smart", { name = sm:name(), x = sm.position.x, y = sm.position.y, z = sm.position.z,
				vid = sm.m_level_vertex_id, level = level.name() })
			n = n + 1
		end
	end
	return true, n .. " smarts"
end

-- changers — переходы на другие уровни (level_changer) текущего уровня в trace: раннер не ставит игрока рядом
-- (17.11: спавн у перехода — игрок уходит с локи, бой срывается). Перебор alife один раз, раннер кэширует.
local function cmd_changers(a)
	local sim, gg = alife(), game_graph()
	local here = gg:vertex(db.actor:game_vertex_id()):level_id()
	local n = 0
	for i = 1, 65534 do
		local se = sim:object(i)
		if se and se:clsid() == clsid.level_changer_s and gg:vertex(se.m_game_vertex_id):level_id() == here then
			emit(0, 0, "changer", { x = se.position.x, y = se.position.y, z = se.position.z, level = level.name() })
			n = n + 1
		end
	end
	return true, n .. " changers"
end

-- ===== телеметрия =====

local function on_death(victim, who)
	if not victim then return end
	local sq = get_object_squad(victim)
	local ksq = who and get_object_squad(who)
	emit(sq and sq.id or 0, victim:id(), "death", {
		killer = who and who:id() or -1, ksq = ksq and ksq.id or -1,
		rank = victim.character_rank and victim:character_rank() or 0,
		comm = character_community(victim) or "?",
	})
end

-- нокаут вместо смерти (спарринг): движок зовёт перед смертью игрока; ret_value=false — смерти нет
local function on_before_death(who_id, flags)
	local now = time_global()
	local side = player_side(match)
	if not side and now > ko_until then return end   -- вне спарринга — смерть как обычно
	flags.ret_value = false
	heal_actor()
	if not side or match.ko then return end
	match.ko = true
	ko_until = now + KO_GUARD_MS
	level.add_pp_effector("fade_in_out.ppe", 74001, false)   -- v0.5: нокаут видно, а не молча
	say("KNOCKOUT! You are down — fight lost.", 8)
	local who = who_id and level.object_by_id(who_id)
	local ksq = who and get_object_squad(who)
	emit(0, 0, "death", { killer = who_id or -1, ksq = ksq and ksq.id or -1, ko = 1,
		rank = db.actor:character_rank(), comm = "actor" })
	local _, on = side_members(side == "A" and match.sides.B or match.sides.A)
	-- лежачего не добивают. 17.11: не set_relation(neutral) — он ставит личное 0, и вражеская группировка в сумме
	-- оставалась врагом (relation_registry_inline.h GetAttitude); личное с запасом вверх → точно не враг
	for _, o in ipairs(on) do o:force_set_goodwill(10000, db.actor) end
end

local function on_hit(npc, amount, dir, who, bone)
	if not (npc and who and amount and amount > 0) then return end
	local sq = get_object_squad(npc)
	local wsq = who.id and get_object_squad(who)
	emit(sq and sq.id or 0, npc:id(), "hit", {
		who = who:id(), wsq = wsq and wsq.id or -1, amount = amount, bone = bone or -1,
		d = npc:position():distance_to(who:position()),
		dy = who:position().y - npc:position().y,     -- высота стрелка над целью (башни!)
		saw = npc:see(who) and 1 or 0,
	})
end

-- ===== выстрелы (21.10) =====
-- Движок решает «стреляю» по глазам: враг виден, голова довёрнута (CStalkerActionCombatBase::fire);
-- линию от ствола до цели не проверяет никто — object handler смотрит только «свой на линии».
-- Поэтому на каждый выстрел NPC пишем: видят ли его глаза врага и свободны ли две линии до груди
-- врага — от глаз и от ствола (≈ рука + полметра к цели). Лучи — движковый ray_pick по статике,
-- как в varka_probe. Сколько пуль ушло в стену и почему — считает tools/twin/match/shots.py.
local RQT_STATIC  = 2       -- collide::rqtStatic
local MUZZLE_FWD  = 0.5     -- от кисти до дульного среза, м (грубо, для автомата)
local SHOT_SLACK  = 0.5     -- упёрлись ближе чем за полметра до цели — это уже её укрытие, не наше
local rp_shot

-- Свободна ли линия a → b: true / false и где упёрлись
local function line_clear(a, b)
	local dir = vector():set(b):sub(a)
	local d = dir:magnitude()
	if d < 0.5 then return true, d end
	dir:normalize()
	rp_shot:set_position(a)
	rp_shot:set_direction(dir)
	rp_shot:set_range(d)
	if rp_shot:query() then
		local hit = rp_shot:get_distance()
		return hit >= d - SHOT_SLACK, hit
	end
	return true, d
end

-- Угол между направлением v и линией на цель to, в градусах. yaw_only — только по горизонтали.
local function angle_to(v, to, yaw_only)
	if yaw_only then
		local a = math.atan2(v.x, v.z) - math.atan2(to.x, to.z)
		a = (a + math.pi) % (2 * math.pi) - math.pi
		return math.abs(math.deg(a))
	end
	local lv, lt = v:magnitude(), to:magnitude()
	if lv < 1e-4 or lt < 1e-4 then return -1 end
	local c = (v.x * to.x + v.y * to.y + v.z * to.z) / (lv * lt)
	return math.deg(math.acos(math.max(-1, math.min(1, c))))
end

local function on_fired(npc, wpn, ammo)
	if not (npc and npc.alive and npc:alive()) then return end
	if not rp_shot then
		rp_shot = ray_pick()
		rp_shot:set_flags(RQT_STATIC)
	end
	local enemy = npc:best_enemy()
	local sq = get_object_squad(npc)
	local f = { wpn = wpn and wpn:section() or "?", ammo = ammo or -1,
		cr = npc:body_state() == move.crouch and 1 or 0 }
	if varka_lkp and varka_lkp.goap_ids then
		local ok, aid, aid2 = pcall(varka_lkp.goap_ids, npc)
		if ok then f.aid, f.aid2 = aid, aid2 end
	end
	if enemy then
		local chest = utils_obj.safe_bone_pos(enemy, "bip01_spine1")
		local eye = utils_obj.safe_bone_pos(npc, "bip01_head")
		local hand = utils_obj.safe_bone_pos(npc, "bip01_r_hand")
		local to = vector():set(chest):sub(hand)
		local d = to:magnitude()
		if d > 0.01 then to:mul(MUZZLE_FWD / d) end
		local muzzle = vector():set(hand):add(to)
		local mc, mhit = line_clear(muzzle, chest)
		local ec, ehit = line_clear(eye, chest)
		local seen = npc:memory_time(enemy)
		f.enemy = enemy:id()
		f.d = npc:position():distance_to(enemy:position())
		f.see = npc:see(enemy) and 1 or 0
		f.since = (seen and seen > 0) and (time_global() - seen) or -1   -- мс с последнего «вижу»
		f.mc, f.mhit = mc and 1 or 0, mhit     -- ствол → грудь врага: свободно / где упёрлись
		f.ec, f.ehit = ec and 1 or 0, ehit     -- глаза → грудь врага
		f.ex, f.ey, f.ez = chest.x, chest.y, chest.z
		-- Насколько стрелок не довернул: движок разрешает огонь, пока взгляд в ai_aim_fire_angle (22.5°)
		-- от врага. Голову из Lua не достать — пишем тело (по горизонтали) и объект оружия (полный угол).
		local aim = vector():set(chest):sub(eye)
		f.ab = angle_to(npc:direction(), aim, true)
		f.ah = angle_to(npc:head_orientation(), aim, true)  -- голова: по ней движок решает «довернулся ли»
		if wpn then f.aw = angle_to(wpn:direction(), vector():set(chest):sub(muzzle)) end
		if varka_stress then varka_stress.under_fire(enemy, f.d) end  -- по нему стреляют — износ
		if varka_survive then varka_survive.shot_at(enemy, npc) end    -- стреляют в упор — фокус на стрелка
	end
	local p = npc:position()
	f.px, f.py, f.pz = p.x, p.y, p.z
	emit(sq and sq.id or 0, npc:id(), "shot", f)
end

-- Колбэк вешаем на каждого бойца один раз; флаг в db.storage — после офлайна боец приходит
-- с новым storage, и мы встраиваемся заново (как varka_cmd).
local function hook_shots(npc)
	if not (npc and IsStalker(npc) and npc:alive()) then return end
	local st = db.storage[npc:id()]
	if not st or st.varka_shot_hooked then return end
	st.varka_shot_hooked = true
	npc:set_callback(callback.weapon_fired, on_fired)
end

function on_game_start()
	RegisterScriptCallback("npc_on_update", hook_shots)
	RegisterScriptCallback("actor_on_update", tick)
	RegisterScriptCallback("npc_on_death_callback", on_death)
	RegisterScriptCallback("npc_on_hit_callback", on_hit)
	RegisterScriptCallback("actor_on_hit_callback", on_hit)          -- v0.4: попадания по игроку
	RegisterScriptCallback("actor_on_before_death", on_before_death) -- v0.4: нокаут в спарринге
	RegisterScriptCallback("actor_on_first_update", function()
		if varka_cmd and varka_cmd.register then
			varka_cmd.register("match_begin", cmd_begin)
			varka_cmd.register("match_abort", cmd_abort)
			varka_cmd.register("clear", cmd_clear)
			varka_cmd.register("smarts", cmd_smarts)
			varka_cmd.register("changers", cmd_changers)
			varka_cmd.register("vanish", cmd_vanish)
		end
	end)
end
