-- varka_suppress.script — ОГОНЬ ПО ВЕРЕ v0.2 (29.10.2026): «куда-то туда» — в точку пика
--
-- Бой на вершине (29.10, игра юзера, l07, отряд 21224): 3.6 минуты, 9 попаданий игрока — все в тех, кто его
-- в тот миг не видел; отряд — 38 выстрелов, и ни одного по месту, где игрок мог быть. Роль varka_clear бьёт
-- только по видимой цели. Пресет «штурм» дирижёра задуман «масса прижимает в лоб, один с фланга», — но у
-- «прижать» не было рук: весь бой mode = hold и молчание.
--
-- ВЕСТЬ — СВОЯ, не память движка (v0.2). v0.1 брал memory_position, а она врёт двумя способами
-- (sound_memory_manager.cpp, feel_sound_new):
--   · услышал выстрел врага → движок кладёт ему «попадание» (// this is fake!: memory().hit().add) — память с
--     ТОЧНОЙ позицией стрелка за 90 м на слух. Чит;
--   · звук удара пули (WPN_hit) — в памяти с автором-стрелком, но позиция = место удара, т.е. рядом с нами.
--     Он приходит позже выстрела и перебивает его — бой «себе под ноги».
-- Поэтому весть пишем сами: услышал выстрел (WPN_shoot) — точка звука с ошибкой уха (по дальности EAR_RANGE,
-- вбок EAR_LAT от дистанции: направление ухо берёт лучше расстояния); видел и потерял — последняя увиденная
-- точка, без ошибки. Удар пули рядом — не весть о стрелке, это повод для рефлекса (не здесь).
--
-- ПИК-ТОЧКИ (v0.2, юзер: «бить в точку пика, я должен видеть трассеры»). Из глаз бойца к вести — луч. Луч
-- свободен — точка на виду, бьём в неё. Упёрся рядом с вестью (не дальше LAND_R) — это ЕГО укрытие: сканируем
-- вбок (шаг EDGE_STEP м на глубине укрытия) до первого свободного луча — край, оттуда он выглянет; так же вверх
-- (над укрытием) — верх. Маленький просвет внутри укрытия скан тоже находит: свободный луч — «край». Цель — точка
-- сразу за углом (PEEK_BEHIND). Двое стреляющих отряда берут РАЗНЫЕ края одной вести. Упёрся далеко от вести
-- (бугор на полпути) — этот боец её не достанет.
--
-- Что делает: свежая весть (REACT_MS..FRESH_MS) → боец, который врага сейчас НЕ видит, одно окно WINDOW_MS бьёт
-- очередями в пик-точку. Новая весть — новое окно (он выстрелил — ответили).
-- Цена: патроны и своя позиция — на отряд не больше MAX_SQ стреляющих, флангер и разведчик дирижёра молчат,
-- почти пустой магазин и снайперка — нет.
-- Ворота как у varka_aim: довернулся к точке; ствол у себя свободен (сидя, иначе встать над укрытием).
-- Пуля летит из глаз по взгляду (g_fireParams, ai_stalker_fire.cpp: P = eye_matrix.c, D = eye_matrix.k) — данность
-- движка; взгляд — look_position state_mgr (позы varka_aim без анимации — высота точки сохраняется).
-- Своего на линии движок прострелить не даст (object_actions.cpp: can_kill_member).
-- Порядок: граната и «жить хочу» главнее, приказы varka_cmd — тоже; огонь главнее веры (varka_clear), боя,
-- опасности и A-Life.
--
-- Trace: supp_start {how, d, age, kind, peeks, st, err} (err — точка от настоящего врага, только для разбора),
-- supp_fire {ms}, supp_end {shots, why}, supp_skip {why} (раз на весть).
--
-- id: 188215 оценщик, 188216 действие.

local EVA_SUPP, ACT_SUPP = 188215, 188216
local EVA_SURV, EVA_GRN  = 188211, 188213   -- «жить хочу», граната
local EVA_SOFT, EVA_HARD = 188201, 188203   -- приказы varka_cmd

local FRESH_MS   = 6000   -- мс: весть свежая (дальше — роли веры, varka_belief GRACE_MS)
local REACT_MS   = 400    -- мс: реакция — услышал не значит ответил в тот же кадр
local WINDOW_MS  = 2500   -- мс: одно окно огня на весть
local RECHECK_MS = 300    -- мс: отказ по воротам — пересмотр не чаще
local MAX_SQ     = 2      -- стреляющих «туда» на отряд разом
local MIN_D, MAX_D = 3, 120
local MAG_MIN    = 0.25   -- доля магазина: меньше — не тратить
local TARGET_H   = 1.0    -- м: грудь сидящего над ногами (весть глазами)
local EAR_RANGE, EAR_LAT = 0.15, 0.03   -- σ ошибки уха: доля дистанции по дальности / вбок
local LAND_R     = 4      -- м: упёрлись не дальше этого от вести — её укрытие; дальше — не достать
local EDGE_STEP, EDGE_STEPS = 0.4, 12   -- скан края вбок: шаг на глубине укрытия, м; шагов (до 4.8 м)
local TOP_STEP, TOP_STEPS   = 0.2, 4    -- скан верха: шаг вверх, м; шагов (до 0.8 м над вестью)
local EDGE_PAST  = 1.0    -- м: луч прошёл глубину укрытия на столько — край
local PEEK_BEHIND = 0.4   -- м: точка пика — сразу за углом
local RQT_STATIC = 2

local news    = {}   -- id → { x, y, z, t, who, how } — последняя весть о враге своими ушами/глазами
local sup     = {}   -- id → окно { t, who, kind, key, until_t, pos, stance, t0, mag, fired, running }
local done    = {}   -- id → t вести, на которую уже ответили
local recheck = {}   -- id → не раньше
local skipped = {}   -- id → t вести, про которую уже написали supp_skip

local function emit(npc, ev, f)
	if varka_trace then varka_trace.emit(varka_lkp.get_squad_key(npc), npc:id(), ev, f) end
end

local function skip(npc, t, why)
	if skipped[npc:id()] == t then return end
	skipped[npc:id()] = t
	emit(npc, "supp_skip", { why = why })
end

-- σ = 1 (сумма четырёх равномерных)
local function gauss()
	return (math.random() + math.random() + math.random() + math.random() - 2) * 1.732
end

local rp
local function ray_dist(a, dir, range)
	if not rp then rp = ray_pick(); rp:set_flags(RQT_STATIC) end
	rp:set_position(a); rp:set_direction(dir); rp:set_range(range)
	if rp:query() then
		local d = rp:get_distance()
		if d < range then return d end
	end
	return nil
end

local function dir_of(yaw, pitch)
	return vector():set(math.sin(yaw) * math.cos(pitch), math.sin(pitch), math.cos(yaw) * math.cos(pitch))
end

-- Пик-точки вести P с глаз E: { {pos, kind}, ... } | nil, почему
local function peek_points(eye, P)
	local dir = vector():set(P):sub(eye)
	local D = dir:magnitude()
	dir:normalize()
	local h = ray_dist(eye, dir, D)
	if not h or D - h < 0.5 then return { { pos = P, kind = "open" } } end
	if D - h > LAND_R then return nil, "land" end
	local out = {}
	local yaw = math.atan2(dir.x, dir.z)
	local pitch = math.atan2(dir.y, math.sqrt(dir.x * dir.x + dir.z * dir.z))
	for _, side in ipairs({ 1, -1 }) do
		for k = 1, EDGE_STEPS do
			local dd = dir_of(yaw + side * math.atan2(k * EDGE_STEP, h), pitch)
			if not ray_dist(eye, dd, h + EDGE_PAST) then
				out[#out + 1] = { pos = vector():set(eye):add(dd:mul(h + PEEK_BEHIND)), kind = side > 0 and "edge_a" or "edge_b",
				                  lat = k * EDGE_STEP }
				break
			end
		end
	end
	local base = vector():set(eye):add(vector():set(dir):mul(h))
	for k = 1, TOP_STEPS do
		local q = vector():set(base.x, base.y + k * TOP_STEP, base.z)
		local dq = vector():set(q):sub(eye)
		local dl = dq:magnitude()
		dq:normalize()
		if not ray_dist(eye, dq, dl + EDGE_PAST) then
			out[#out + 1] = { pos = vector():set(eye):add(dq:mul(dl + PEEK_BEHIND)), kind = "top", lat = k * TOP_STEP }
			break
		end
	end
	if #out == 0 then return nil, "no_edge" end
	table.sort(out, function(a, b) return a.lat < b.lat end)   -- ближний к вести край — вероятнее
	return out
end

-- ===== ВЕСТЬ =====

local function on_hear(npc, who_id, s_type, dist, power, pos)
	if s_type ~= "WPN_shoot" or not (pos and who_id) then return end
	if not (npc and npc:alive() and IsStalker(npc)) or varka_vanilla.is(npc) then return end
	local who = (db.storage[who_id] and db.storage[who_id].object) or level.object_by_id(who_id)
	if not (who and who:alive()) or npc:relation(who) < game_object.enemy then return end
	local p = npc:position()
	local dx, dz = pos.x - p.x, pos.z - p.z
	local d = math.sqrt(dx * dx + dz * dz)
	if d < 0.5 then return end
	local ux, uz = dx / d, dz / d
	local er, el = d * EAR_RANGE * gauss(), d * EAR_LAT * gauss()
	news[npc:id()] = { x = pos.x + ux * er - uz * el, y = pos.y, z = pos.z + uz * er + ux * el,
	                   t = time_global(), who = who_id, how = "ear" }
end

-- ===== ОКНО ОГНЯ =====

local function mag_frac(npc)
	local w = npc:active_item()
	if not (w and IsWeapon(w) and not IsMelee(w)) then return nil end
	local size = ini_sys:r_float_ex(w:section(), "ammo_mag_size") or 0
	if size < 1 then return nil end
	return (w:get_ammo_in_magazine() or 0) / size, w
end

-- сколько стреляют в отряде и какие края этой вести уже заняты
local function squad_taken(key, id, who, now)
	local n, kinds = 0, {}
	for oid, s in pairs(sup) do
		if oid ~= id and s.key == key and now < s.until_t then
			n = n + 1
			if s.who == who then kinds[s.kind] = true end
		end
	end
	return n, kinds
end

local function open_window(npc, n, now)
	if varka_director then
		local role = varka_director.get_role(npc)
		if role == "flank" or role == "scout" then return nil, "role" end
	end
	local frac, w = mag_frac(npc)
	if not frac then return nil, "weapon" end
	local kind = ini_sys:r_string_ex(w:section(), "kind")
	if kind == "w_sniper" then return nil, "sniper" end
	if frac < MAG_MIN then return nil, "mag" end
	local key = varka_lkp.get_squad_key(npc)
	local busy, taken = squad_taken(key, npc:id(), n.who, now)
	if busy >= MAX_SQ then return nil, "busy" end

	local p = npc:position()
	local P = vector():set(n.x, n.y, n.z)
	local d = p:distance_to(P)
	if d < MIN_D or d > MAX_D then return nil, "dist" end
	if kind == "w_shotgun" and d > 25 then return nil, "shotgun" end
	local crouch = npc:body_state() == move.crouch
	local eye = vector():set(p.x, p.y + (crouch and 1.0 or 1.5), p.z)
	local peeks, why = peek_points(eye, P)
	if not peeks then return nil, why end
	for _, pk in ipairs(peeks) do
		if not taken[pk.kind] then
			local stance = varka_aim.point_stance(npc, pk.pos)
			if stance then
				return { t = n.t, who = n.who, kind = pk.kind, key = key, until_t = now + WINDOW_MS, pos = pk.pos,
				         stance = stance, t0 = now, mag = w:get_ammo_in_magazine() or 0, d = d, age = now - n.t,
				         how = n.how, peeks = #peeks }
			end
		end
	end
	return nil, "barrel"
end

local function want(npc)
	local id, now = npc:id(), time_global()
	local s = sup[id]
	if s then
		if now < s.until_t then return true end
		if s.running then return false end   -- окно кончилось: убирает finalize (там supp_end)
		sup[id] = nil                        -- окно открыли, а действие так и не взяли
	end
	if not npc:alive() or IsWounded(npc) then return false end
	-- видит врага — весть глазами (точка, где потерял); огонь по видимому — не наше дело
	local be = npc:best_enemy()
	if be and be:alive() and npc:see(be) then
		local bp = be:position()
		news[id] = { x = bp.x, y = bp.y + TARGET_H, z = bp.z, t = now, who = be:id(), how = "eye" }
		return false
	end
	local n = news[id]
	if not n or done[id] == n.t then return false end
	local age = now - n.t
	if age < REACT_MS or age > FRESH_MS then return false end
	if now < (recheck[id] or 0) then return false end
	recheck[id] = now + RECHECK_MS
	local who = level.object_by_id(n.who)
	if not (who and who:alive()) or IsWounded(who) then done[id] = n.t; return false end
	if npc:see(who) then return false end
	local w, why = open_window(npc, n, now)
	if not w then skip(npc, n.t, why); return false end
	done[id] = n.t
	sup[id] = w
	local wp = who:position()
	local err = math.sqrt((w.pos.x - wp.x) ^ 2 + (w.pos.z - wp.z) ^ 2)
	emit(npc, "supp_start", { enemy = n.who, how = w.how, d = w.d, age = w.age, kind = w.kind, peeks = w.peeks,
	                          st = w.stance, err = err, px = w.pos.x, py = w.pos.y, pz = w.pos.z })
	return true
end

class "eva_varka_suppress" (property_evaluator)
function eva_varka_suppress:__init(name) super(nil, name) end
function eva_varka_suppress:evaluate()
	return want(self.object)
end

class "act_varka_suppress" (action_base)
function act_varka_suppress:__init(name) super(nil, name) end

function act_varka_suppress:initialize()
	action_base.initialize(self)
	local npc = self.object
	if not npc:alive() then return end
	npc:set_path_type(game_object.level_path)
	local s = sup[npc:id()]
	if s then s.running = true end
end

function act_varka_suppress:execute()
	action_base.execute(self)
	local npc = self.object
	if not npc:alive() then return end
	local s = sup[npc:id()]
	if not s then return end
	local fire = varka_aim.facing_point(npc, s.pos)
	if fire and not s.fired then
		s.fired = true
		emit(npc, "supp_fire", { ms = time_global() - s.t0 })
	end
	varka_aim.trigger_point(npc, s.pos, fire)
	state_mgr.set_state(npc, s.stance == "stand" and "varka_aim_stand" or "varka_aim_crouch", nil, nil,
	                    { look_position = s.pos }, { fast_set = true })
	utils_obj.send_to_nearest_accessible_vertex(npc, npc:level_vertex_id(), "varka_suppress")
end

function act_varka_suppress:finalize()
	local npc = self.object
	varka_aim.release(npc)
	local s = sup[npc:id()]
	if s then
		local _, w = mag_frac(npc)
		local left = w and w:get_ammo_in_magazine() or s.mag
		emit(npc, "supp_end", { shots = math.max(0, s.mag - left), why = time_global() < s.until_t and "yield" or "done" })
		sup[npc:id()] = nil
	end
	action_base.finalize(self)
end

-- Встраивание — после varka_cmd, varka_clear, varka_survive и varka_grenade: условия «граната / жить хочу /
-- приказ не активны» ссылаются на их оценщики, а условие на несуществующий оценщик — падение движка. Условие
-- «огня нет» вешаем ТОЛЬКО на действия, которые у бойца точно есть (manager:action — lower_bound, см. varka_survive).
local function yield_ids(npc)
	local st = db.storage[npc:id()]
	local ids = { xr_actions_id.alife, xr_actions_id.state_mgr + 2, stalker_ids.action_combat_planner, stalker_ids.action_danger_planner }
	if st.varka_clear_hooked then ids[#ids + 1] = 188210 end                            -- вера: заглянуть / держать край
	if st.rx_ff then ids[#ids + 1] = 18803 end                                           -- свой на линии
	if st.kill_wounded and xrs_kill_wounded and xrs_kill_wounded.is_enabled() then ids[#ids + 1] = 188112 end
	if st.fight_from_cover or st.axr_fight_from_cover then ids[#ids + 1] = 188118 end   -- бой из укрытия
	return ids
end

local function hook_npc(npc)
	local manager = npc:motivation_action_manager()
	if not manager then return end
	local st = db.storage[npc:id()]
	local wp = world_property
	manager:add_evaluator(EVA_SUPP, eva_varka_suppress("eva_varka_suppress"))
	local act = act_varka_suppress("act_varka_suppress")
	act:add_precondition(wp(stalker_ids.property_alive, true))
	act:add_precondition(wp(EVA_SUPP, true))
	if st.varka_survive_hooked then act:add_precondition(wp(EVA_SURV, false)) end
	if st.varka_grenade_hooked then act:add_precondition(wp(EVA_GRN, false)) end
	if st.varka_cmd_hooked then
		act:add_precondition(wp(EVA_SOFT, false))
		act:add_precondition(wp(EVA_HARD, false))
	end
	act:add_effect(wp(EVA_SUPP, false))
	manager:add_action(ACT_SUPP, act)
	for _, id in ipairs(yield_ids(npc)) do
		local a = manager:action(id)
		if a then a:add_precondition(wp(EVA_SUPP, false)) end
	end
end

local function npc_update(npc)
	if varka_vanilla.is(npc) then return end  -- отряд «чистая ваниль»
	if not (npc and npc:alive() and IsStalker(npc)) then return end
	if character_community(npc) == "zombied" then return end
	local st = db.storage[npc:id()]
	-- флаг в db.storage: после офлайна боец приходит с новым планировщиком — встраиваемся заново
	if not st or st.varka_suppress_hooked then return end
	if varka_cmd and not st.varka_cmd_hooked then return end
	if varka_clear and not st.varka_clear_hooked then return end
	if varka_survive and not st.varka_survive_hooked then return end
	if varka_grenade and not st.varka_grenade_hooked then return end
	st.varka_suppress_hooked = true
	hook_npc(npc)
end

local function npc_death(npc)
	local id = npc:id()
	news[id], sup[id], done[id], recheck[id], skipped[id] = nil, nil, nil, nil, nil
end

function on_game_start()
	RegisterScriptCallback("npc_on_update", npc_update)
	RegisterScriptCallback("npc_on_hear_callback", on_hear)
	RegisterScriptCallback("npc_on_death_callback", npc_death)
end
