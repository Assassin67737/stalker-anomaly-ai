-- varka_suppress.script — КОНТАКТ v0.4 (29.10.2026): «не вижу, но весть свежая» — целиком нашими руками
--
-- v0.4 (серия natural, 10 матчей v0.3, вердикт «дебилы»):
--   · смотрели вверх: +EYE_UP к ногам шло ВСЕМ звукам, кроме выстрела, а голос, боль, перезарядка, достать ствол
--     (xr_hear get_sound_type) звучат уже у головы/рук → точка ~3 м над землёй. Теперь высота вести = земля под
--     точкой (нода навмеша) + высота источника над своей землёй (0.4–1.6), шаги — EYE_UP.
--   · «колбасит»: 38% контактов короче 1 с, 40% снова через < 1 с, и на каждом входе — новое укрытие и новый взгляд.
--     Теперь: вернулся быстрее REENTER_MS — то же состояние; весть сдвинулась меньше NEWS_MOVE — укрытие и взгляд те же;
--     увидел врага — конец, только если видит SEE_STABLE подряд.
--   · сидел, пока весть свежая, а все окна «land» (бугор между ним и вестью; 536 отказов из 870) — теперь ВЫХОД НА
--     ОГНЕВУЮ: ближняя нода, откуда весть достать, — туда, окно PEEK_WIN_MS, назад в укрытие («в, в, н»).
--     Укрытие «его» для вести на слух — с запасом на ошибку уха по дальности (LAND_EAR × σ).
--   · ctc_end пишет why.
--
-- v0.1–0.2 — огонь по вере («куда-то туда», в точку пика). v0.3 — всё состояние между «видел» и «ищу»:
-- взгляд, укрытие, огонь, перезарядка. До него эти секунды (до GRACE_MS веры) отдавались ванильному бою 89 —
-- а тот, не видя врага, ставит взгляд на память движка (stalker_combat_actions.cpp: «в укрытие» 670, «выглянуть» 780,
-- «внезапная атака» 1293 — mem_object.m_object_params.m_position) и ведёт врага сквозь бетон (natural #2, боец 5647);
-- и перезаряжает на месте стоя (аудит natural, 59 перезарядок: ванильных на месте 28, стоя 27, под взглядом 20).
--
-- ВЕСТЬ — СВОЯ, не память движка. memory_position врёт (sound_memory_manager.cpp, feel_sound_new):
--   · услышал выстрел врага → движок кладёт «попадание» (// this is fake!: memory().hit().add) — ТОЧНАЯ позиция стрелка;
--   · звук удара пули (WPN_hit) — с автором-стрелком, но позиция = место удара, рядом с нами.
-- Пишем сами: услышал (любой звук врага, кроме удара пули) — точка звука с ошибкой уха (по дальности EAR_RANGE,
-- вбок EAR_LAT от дистанции: направление ухо берёт лучше расстояния); видел и потерял — последняя увиденная точка.
-- Высота вести — глаза (звук выстрела — у ствола ≈ у глаз; увиденный — ноги + EYE_UP). Из неё же сеет облако вера
-- (varka_belief: news()).
--
-- ЧТО ДЕЛАЕТ БОЕЦ (одно действие, фазы):
--   1. новая весть → видно ли меня, присевшего, с неё (лучи к голове и груди). Видно — бегом (assault, не спринт:
--      спринт ломал перезарядку, v0.3 survive) в ближнюю ноду, которую с вести не видно и которая не ближе к ней.
--   2. ОКНО ОГНЯ по новой вести (после REACT_MS): очереди WINDOW_MS в пик-точку — край его укрытия, верх, просвет;
--      двое стреляющих отряда берут разные края; на отряд не больше MAX_SQ; флангер и разведчик дирижёра молчат.
--   3. ДЕРЖАТЬ: сидя, ствол поднят на пик-точку (взгляд — по вести, не по кости). Магазин меньше RL_FRAC и с вести
--      меня не видно — перезарядка (магазин в ноль, движок играет её сам, пока ствол поднят; не пошла за RL_UNDO —
--      патроны назад; Lua-команды «перезарядить» нет — object.reload = краш, см. varka_weapons). Пуст — движок сам.
-- Конец: увидел врага (прицельный огонь — бой), весть старше CONTACT_MS, или после GRACE_MS у бойца роль веры.
--
-- ПИК-ТОЧКИ. Из глаз бойца к вести — луч. Свободен — точка на виду, бьём в неё. Упёрся рядом с вестью (не дальше
-- LAND_R) — это ЕГО укрытие: скан вбок (шаг EDGE_STEP на глубине укрытия) до первого свободного луча — край; так же
-- вверх — верх. Просвет внутри укрытия скан тоже находит. Цель — сразу за углом (PEEK_BEHIND). Упёрся далеко (бугор
-- на полпути) — этот боец её не достанет.
-- Пуля летит из глаз по взгляду (g_fireParams, ai_stalker_fire.cpp: P = eye_matrix.c, D = eye_matrix.k) — данность
-- движка; взгляд — look_position state_mgr (позы varka_aim без анимации — высота точки сохраняется).
-- Своего на линии движок прострелить не даст (object_actions.cpp: can_kill_member).
-- Порядок: граната, «жить хочу» и жёсткий приказ главнее; контакт главнее мягкого приказа, веры (varka_clear), боя,
-- опасности и A-Life.
--
-- Trace: ctc_start {back — вернулся через, мс}, ctc_end {ms, why}, ctc_peek {d, why} / ctc_peek_fail {why}, ctc_cover {d, n} / ctc_cover_none, ctc_reload {mag} / ctc_reload_done {ms} /
-- ctc_reload_undo; supp_start {how, d, age, kind, peeks, st, err} (err — точка от настоящего врага, только для
-- разбора), supp_fire {ms}, supp_end {shots, why}, supp_skip {why}.
--
-- id: 188215 оценщик, 188216 действие.

local EVA_SUPP, ACT_SUPP = 188215, 188216
local EVA_SURV, EVA_GRN  = 188211, 188213   -- «жить хочу», граната
local EVA_HARD = 188203                     -- жёсткий приказ varka_cmd

local CONTACT_MS = 8000   -- мс: весть свежая — контакт (после GRACE_MS — если у бойца нет роли веры)
local GRACE_MS   = 6000   -- = GRACE_MS varka_belief: с этого момента роли веры
local REENTER_MS = 2000   -- мс: вернулся в контакт быстрее — состояние то же (укрытие, взгляд)
local NEWS_MOVE  = 2.5    -- м: весть сдвинулась меньше — укрытие и взгляд не пересчитывать
local SEE_STABLE = 300    -- мс: увидел врага — конец контакта, только если видит столько подряд (мигание зрения)
local REACT_MS   = 400    -- мс: реакция — услышал не значит ответил в тот же кадр
local WINDOW_MS  = 2500   -- мс: одно окно огня на весть
local RECHECK_MS = 300    -- мс: отказ по воротам огня — пересмотр не чаще
local MAX_SQ     = 2      -- стреляющих «туда» на отряд разом
local MIN_D, MAX_D = 3, 120
local MAG_MIN    = 0.25   -- доля магазина: меньше — не тратить на огонь «туда»
local EYE_UP     = 1.4    -- м: глаза над ногами (весть глазами)
local AIM_DOWN   = 0.2    -- м: цель чуть ниже глаз вести — голова у края
local EAR_RANGE, EAR_LAT = 0.15, 0.03   -- σ ошибки уха: доля дистанции по дальности / вбок
local LAND_R     = 4      -- м: упёрлись не дальше этого от вести — её укрытие; дальше — не достать
local LAND_EAR   = 1.5    -- весть на слух: «не дальше» = max(LAND_R, LAND_EAR · σ дальности уха)
local SRC_H_MIN, SRC_H_MAX = 0.4, 1.6   -- м: высота источника звука над его землёй (лёжа … голова)
local PEEK_RINGS = { 1.5, 3, 5 }        -- м: где искать огневую, если отсюда не достать
local PEEK_MS    = 3000   -- мс: не дошёл до огневой — открыть окно там, где стоит
local PEEK_WIN_MS = 1500  -- мс: окно огня с огневой — «высунулся, выстрелил, нырнул»
local PEEK_CD    = 4000   -- мс между выходами одного бойца
local PEEK_AGE   = 3000   -- мс: весть старше — на огневую не выходить
local EDGE_STEP, EDGE_STEPS = 0.4, 12   -- скан края вбок: шаг на глубине укрытия, м; шагов (до 4.8 м)
local TOP_STEP, TOP_STEPS   = 0.2, 4    -- скан верха: шаг вверх, м; шагов (до 0.8 м)
local EDGE_PAST  = 1.0    -- м: луч прошёл глубину укрытия на столько — край
local PEEK_BEHIND = 0.4   -- м: точка пика — сразу за углом
local BODY_CR    = { 1.1, 0.75 }        -- голова и грудь присевшего
local COVER_RINGS = { 2, 4, 6, 9 }      -- м: где искать укрытие от вести (8 направлений)
local COVER_MS   = 5000   -- мс: не добежал — держать где стоит
local ARRIVE_SQR = 1.0
local RL_FRAC    = 0.5    -- доля магазина: меньше — перезарядиться в укрытии
local RL_UNDO    = 5000   -- мс: перезарядка не пошла — патроны назад
local RL_BLOCK   = 8000   -- мс после отката без новой попытки
local WST_RELOAD = 7      -- CWeapon::eReload
local INVALID_VID = 4294967295
local RQT_STATIC = 2

local news    = {}   -- id → { x, y, z, t, who, how } — последняя весть о враге своими ушами/глазами (y — глаза)
local ctc     = {}   -- id → состояние действия { nt, look, cover, cover_t0, exposed, win, rl, rl_block, t0 }
local sup     = {}   -- id → окно огня { who, kind, key, until_t } (для счёта по отряду)
local done    = {}   -- id → t вести, на которую уже ответили огнём
local recheck = {}   -- id → не раньше
local skipped = {}   -- id → t вести, про которую уже написали supp_skip
local prev    = {}   -- id → { s, t } — состояние ушедшего контакта (вернётся быстрее REENTER_MS — продолжить)
local seen_t  = {}   -- id → с какого момента видит врага подряд
local why_end = {}   -- id → почему оценщик сказал «контакта нет» (для ctc_end)

local function emit(npc, ev, f)
	if varka_trace then varka_trace.emit(varka_lkp.get_squad_key(npc), npc:id(), ev, f) end
end

local function skip(npc, t, why)
	if skipped[npc:id()] == t then return end
	skipped[npc:id()] = t
	emit(npc, "supp_skip", { why = why })
end

-- σ = 1 (сумма четырёх равномерных)
local function gauss()
	return (math.random() + math.random() + math.random() + math.random() - 2) * 1.732
end

local rp
local function ray_dist(a, dir, range)
	if not rp then rp = ray_pick(); rp:set_flags(RQT_STATIC) end
	rp:set_position(a); rp:set_direction(dir); rp:set_range(range)
	if rp:query() then
		local d = rp:get_distance()
		if d < range then return d end
	end
	return nil
end

-- прямая видимость между точками: лучи в обе стороны (задние грани луч не ловит, как varka_belief)
local function line_free(a, b)
	local dir = vector():set(b):sub(a)
	local d = dir:magnitude()
	if d < 0.5 then return true end
	dir:normalize()
	if ray_dist(a, dir, d - 0.3) then return false end
	return not ray_dist(b, vector():set(dir):invert(), d - 0.3)
end

-- видно ли присевшего, стоящего в pos, с глаз вести E
local function exposed_from(E, pos)
	for _, h in ipairs(BODY_CR) do
		if line_free(E, vector():set(pos.x, pos.y + h, pos.z)) then return true end
	end
	return false
end

local function dir_of(yaw, pitch)
	return vector():set(math.sin(yaw) * math.cos(pitch), math.sin(pitch), math.cos(yaw) * math.cos(pitch))
end

-- Пик-точки вести P с глаз E: { {pos, kind, lat}, ... } | nil, почему
local function peek_points(eye, P, land_r)
	local dir = vector():set(P):sub(eye)
	local D = dir:magnitude()
	dir:normalize()
	local h = ray_dist(eye, dir, D)
	if not h or D - h < 0.5 then return { { pos = P, kind = "open", lat = 0 } } end
	if D - h > (land_r or LAND_R) then return nil, "land" end
	local out = {}
	local yaw = math.atan2(dir.x, dir.z)
	local pitch = math.atan2(dir.y, math.sqrt(dir.x * dir.x + dir.z * dir.z))
	for _, side in ipairs({ 1, -1 }) do
		for k = 1, EDGE_STEPS do
			local dd = dir_of(yaw + side * math.atan2(k * EDGE_STEP, h), pitch)
			if not ray_dist(eye, dd, h + EDGE_PAST) then
				out[#out + 1] = { pos = vector():set(eye):add(dd:mul(h + PEEK_BEHIND)), kind = side > 0 and "edge_a" or "edge_b",
				                  lat = k * EDGE_STEP }
				break
			end
		end
	end
	local base = vector():set(eye):add(vector():set(dir):mul(h))
	for k = 1, TOP_STEPS do
		local q = vector():set(base.x, base.y + k * TOP_STEP, base.z)
		local dq = vector():set(q):sub(eye)
		local dl = dq:magnitude()
		dq:normalize()
		if not ray_dist(eye, dq, dl + EDGE_PAST) then
			out[#out + 1] = { pos = vector():set(eye):add(dq:mul(dl + PEEK_BEHIND)), kind = "top", lat = k * TOP_STEP }
			break
		end
	end
	if #out == 0 then return nil, "no_edge" end
	table.sort(out, function(a, b) return a.lat < b.lat end)   -- ближний к вести край — вероятнее
	return out
end

-- ближняя нода, где присевшего с вести не видно и которая не ближе к вести
local function find_cover(npc, E)
	local p, vid0 = npc:position(), npc:level_vertex_id()
	local dE = p:distance_to(E)
	local n = 0
	for _, r in ipairs(COVER_RINGS) do
		for k = 0, 7 do
			local a = k * math.pi / 4
			local v = level.vertex_in_direction(vid0, vector():set(math.sin(a), 0, math.cos(a)), r)
			if v and v < INVALID_VID and v ~= vid0 and npc:accessible(v) then
				local q = level.vertex_position(v)
				n = n + 1
				if q:distance_to(E) >= dE - 1 and not exposed_from(E, q) then return v, q, n end
			end
		end
	end
	return nil, nil, n
end

-- «не дальше от вести» для этой вести: на слух дальность врёт сильнее — его укрытие может быть ближе точки
local function land_r(n, d)
	if n.how == "eye" then return LAND_R end
	return math.max(LAND_R, LAND_EAR * EAR_RANGE * d)
end

-- одна проба: достать ли весть P с глаз eye (открыто или упёрлись в её укрытие)
local function reach(eye, P, lr)
	local dir = vector():set(P):sub(eye)
	local D = dir:magnitude()
	dir:normalize()
	local h = ray_dist(eye, dir, D)
	return not h or D - h <= lr
end

-- ближняя огневая: нода, откуда весть достать (сидя или стоя); вбок от линии на весть — раньше, чем вперёд/назад
local function find_fire_spot(npc, P, lr)
	local p, vid0 = npc:position(), npc:level_vertex_id()
	local dP = p:distance_to(P)
	local tx, tz = P.x - p.x, P.z - p.z
	local tl = math.sqrt(tx * tx + tz * tz)
	if tl < 0.1 then return nil end
	tx, tz = tx / tl, tz / tl
	local dirs = {}
	for k = 0, 7 do
		local a = k * math.pi / 4
		local dx, dz = math.sin(a), math.cos(a)
		dirs[#dirs + 1] = { x = dx, z = dz, w = math.abs(dx * tx + dz * tz) }
	end
	table.sort(dirs, function(a, b) return a.w < b.w end)
	for _, r in ipairs(PEEK_RINGS) do
		for _, dd in ipairs(dirs) do
			local v = level.vertex_in_direction(vid0, vector():set(dd.x, 0, dd.z), r)
			if v and v < INVALID_VID and v ~= vid0 and npc:accessible(v) then
				local q = level.vertex_position(v)
				if q:distance_to(P) >= dP - 2 then
					for _, hh in ipairs({ 1.0, 1.5 }) do
						if reach(vector():set(q.x, q.y + hh, q.z), P, lr) then return v, q end
					end
				end
			end
		end
	end
	return nil
end

-- ===== ВЕСТЬ =====

-- земля под точкой: нода навмеша (нет ноды — nil)
local function ground_y(x, y, z)
	local v = level.vertex_id(vector():set(x, y, z))
	if v and v < INVALID_VID then return level.vertex_position(v).y end
	return nil
end

local function on_hear(npc, who_id, s_type, dist, power, pos)
	if s_type == "WPN_hit" or not (pos and who_id) then return end   -- удар пули — место удара, не стрелок
	if not (npc and npc:alive() and IsStalker(npc)) or varka_vanilla.is(npc) then return end
	local who = (db.storage[who_id] and db.storage[who_id].object) or level.object_by_id(who_id)
	-- сначала «кто»: звук бывает и от предмета — alive() на нём = ошибка Lua (CSciptEntity: cannot access Alive)
	if not (who and (IsStalker(who) or who:id() == AC_ID) and who:alive()) or npc:relation(who) < game_object.enemy then return end
	local p = npc:position()
	local dx, dz = pos.x - p.x, pos.z - p.z
	local d = math.sqrt(dx * dx + dz * dz)
	if d < 0.5 then return end
	local ux, uz = dx / d, dz / d
	local er, el = d * EAR_RANGE * gauss(), d * EAR_LAT * gauss()
	-- высота: земля под точкой вести + высота источника над своей землёй. Ухо высоту не делит — но выстрел у ствола,
	-- голос у головы, шаги у ног; v0.3 добавлял EYE_UP всему, кроме выстрела, — голос уходил на 3 м (смотрели вверх)
	local x, z = pos.x + ux * er - uz * el, pos.z + uz * er + ux * el
	local g0 = ground_y(pos.x, pos.y, pos.z) or (pos.y - EYE_UP)
	local h = s_type == "MST_step" and EYE_UP or math.min(SRC_H_MAX, math.max(SRC_H_MIN, pos.y - g0))
	local g = ground_y(x, pos.y, z) or g0
	local how = (s_type == "WPN_shoot" and "ear") or (s_type == "MST_step" and "ear_step") or "ear_snd"
	news[npc:id()] = { x = x, y = g + h, z = z, t = time_global(), who = who_id, how = how }
end

-- для varka_belief: посев облака из честной вести
function news_of(npc)
	return news[npc:id()]
end

-- боец сейчас в контакте (наше действие ведёт) — varka_weapons не меняет магазин сам
function in_contact(npc)
	return ctc[npc:id()] ~= nil
end

-- ===== ОКНО ОГНЯ =====

local function mag_frac(npc)
	local w = npc:active_item()
	if not (w and IsWeapon(w) and not IsMelee(w)) then return nil end
	local size = ini_sys:r_float_ex(w:section(), "ammo_mag_size") or 0
	if size < 1 then return nil end
	return (w:get_ammo_in_magazine() or 0) / size, w
end

-- сколько стреляют в отряде и какие края этой вести уже заняты
local function squad_taken(key, id, who, now)
	local n, kinds = 0, {}
	for oid, s in pairs(sup) do
		if oid ~= id and s.key == key and now < s.until_t then
			n = n + 1
			if s.who == who then kinds[s.kind] = true end
		end
	end
	return n, kinds
end

local function open_window(npc, n, now)
	if varka_director then
		local role = varka_director.get_role(npc)
		if role == "flank" or role == "scout" then return nil, "role" end
	end
	local frac, w = mag_frac(npc)
	if not frac then return nil, "weapon" end
	local kind = ini_sys:r_string_ex(w:section(), "kind")
	if kind == "w_sniper" then return nil, "sniper" end
	if frac < MAG_MIN then return nil, "mag" end
	local key = varka_lkp.get_squad_key(npc)
	local busy, taken = squad_taken(key, npc:id(), n.who, now)
	if busy >= MAX_SQ then return nil, "busy" end

	local p = npc:position()
	local P = vector():set(n.x, n.y - AIM_DOWN, n.z)
	local d = p:distance_to(P)
	if d < MIN_D or d > MAX_D then return nil, "dist" end
	if kind == "w_shotgun" and d > 25 then return nil, "shotgun" end
	local crouch = npc:body_state() == move.crouch
	local eye = vector():set(p.x, p.y + (crouch and 1.0 or 1.5), p.z)
	local peeks, why = peek_points(eye, P, land_r(n, d))
	if not peeks then return nil, why end
	for _, pk in ipairs(peeks) do
		if not taken[pk.kind] then
			local stance = varka_aim.point_stance(npc, pk.pos)
			if stance then
				return { who = n.who, kind = pk.kind, key = key, until_t = now + WINDOW_MS, pos = pk.pos, stance = stance,
				         t0 = now, mag = w:get_ammo_in_magazine() or 0, d = d, age = now - n.t, how = n.how, peeks = #peeks }
			end
		end
	end
	return nil, "barrel"
end

local function close_window(npc, s, why)
	local win = s.win
	if not win then return end
	local _, w = mag_frac(npc)
	local left = w and w:get_ammo_in_magazine() or win.mag
	emit(npc, "supp_end", { shots = math.max(0, win.mag - left), why = why })
	s.win, sup[npc:id()] = nil, nil
end

-- ===== ОЦЕНЩИК: контакт есть? =====

-- глаза увиденного: сидит — ниже (поза видна глазами)
local function eye_h(o)
	if o:id() == AC_ID then return IsMoveState("mcCrouch") and 1.0 or 1.5 end
	return o:body_state() == move.crouch and 1.0 or EYE_UP
end

-- видит подряд дольше SEE_STABLE (в контакте) — мигание зрения не рвёт действие
local function sees_stable(npc, o, now)
	local id = npc:id()
	if not npc:see(o) then seen_t[id] = nil; return false end
	seen_t[id] = seen_t[id] or now
	return not ctc[id] or now - seen_t[id] >= SEE_STABLE
end

local function want(npc)
	local id, now = npc:id(), time_global()
	if not npc:alive() or IsWounded(npc) then return false, "wounded" end
	-- видит врага — весть глазами (точка, где потерял); прицельный огонь — не наше дело
	local be = npc:best_enemy()
	if be and be:alive() and npc:see(be) then
		local bp = be:position()
		news[id] = { x = bp.x, y = bp.y + eye_h(be), z = bp.z, t = now, who = be:id(), how = "eye" }
		if sees_stable(npc, be, now) then return false, "see" end
		return true
	end
	local n = news[id]
	if not n then return false, "no_news" end
	local age = now - n.t
	if age > CONTACT_MS then return false, "old" end
	if age > GRACE_MS and varka_belief and varka_belief.role(npc) then return false, "belief" end   -- дальше — руки веры
	local who = level.object_by_id(n.who)
	if not (who and who:alive()) or IsWounded(who) then return false, "who" end   -- раненого — добивание
	if sees_stable(npc, who, now) then return false, "see" end
	return true
end

class "eva_varka_suppress" (property_evaluator)
function eva_varka_suppress:__init(name) super(nil, name) end
function eva_varka_suppress:evaluate()
	local ok, why = want(self.object)
	why_end[self.object:id()] = not ok and why or nil
	return ok
end

-- ===== ДЕЙСТВИЕ =====

class "act_varka_suppress" (action_base)
function act_varka_suppress:__init(name) super(nil, name) end

function act_varka_suppress:initialize()
	action_base.initialize(self)
	local npc = self.object
	if not npc:alive() then return end
	npc:set_path_type(game_object.level_path)
	local id, now = npc:id(), time_global()
	local pv = prev[id]
	prev[id] = nil
	if pv and now - pv.t < REENTER_MS then   -- мигнул и вернулся — продолжить, не выбирать укрытие и взгляд заново
		pv.s.win = nil
		ctc[id] = pv.s
		emit(npc, "ctc_start", { back = now - pv.t })
		return
	end
	ctc[id] = { t0 = now }
	emit(npc, "ctc_start", {})
end

-- новая весть: видно ли меня с неё, куда смотреть
local function on_news(npc, s, n)
	s.nt = n.t
	if s.out or (s.win and s.win.back) then return end   -- вышел на огневую сам — не дёргать назад на полпути
	local E = vector():set(n.x, n.y, n.z)
	-- та же весть, чуть сдвинутая (новый выстрел из того же места) — укрытие и взгляд прежние (v0.3 пересчитывал на
	-- каждый звук: укрытие то слева, то справа — «колбасит»)
	if s.E and s.who == n.who and s.E:distance_to(E) < NEWS_MOVE then return end
	s.E, s.who = E, n.who
	local p = npc:position()
	local crouch = npc:body_state() == move.crouch
	local eye = vector():set(p.x, p.y + (crouch and 1.0 or 1.5), p.z)
	local aim = vector():set(n.x, n.y - AIM_DOWN, n.z)
	local peeks = peek_points(eye, aim, land_r(n, p:distance_to(aim)))
	s.look = peeks and peeks[1].pos or aim
	s.exposed = exposed_from(E, p)
	s.cover = nil
	if s.exposed then
		local v, q, cnt = find_cover(npc, E)
		if v then
			s.cover, s.cover_pos, s.cover_t0 = v, q, time_global()
			emit(npc, "ctc_cover", { d = p:distance_to(q), n = cnt })
		else
			emit(npc, "ctc_cover_none", { n = cnt })
		end
	end
end

local function hold(npc, s, now)
	local frac, w = mag_frac(npc)
	if w then
		if s.rl then
			if (w:get_ammo_in_magazine() or 0) > 0 then
				emit(npc, "ctc_reload_done", { ms = now - s.rl.t }); s.rl = nil
			elseif now - s.rl.t > RL_UNDO and w:get_state() ~= WST_RELOAD then
				w:set_ammo_elapsed(s.rl.m)
				emit(npc, "ctc_reload_undo", { mag = s.rl.m }); s.rl, s.rl_block = nil, now + RL_BLOCK
			end
		elseif frac > 0 and frac < RL_FRAC and not s.exposed and now > (s.rl_block or 0) then
			local kind = ini_sys:r_string_ex(w:section(), "kind")
			if kind ~= "w_shotgun" and kind ~= "w_sniper" then   -- патрон за патроном: обнулить = долгая набивка
				s.rl = { m = w:get_ammo_in_magazine() or 0, t = now }
				w:set_ammo_elapsed(0)
				emit(npc, "ctc_reload", { mag = s.rl.m })
			end
		end
	end
	varka_aim.trigger_point(npc, s.look, false)   -- ствол поднят на пик: так движок и перезаряжает
	state_mgr.set_state(npc, "varka_aim_crouch", nil, nil, { look_position = s.look }, { fast_set = true })
	utils_obj.send_to_nearest_accessible_vertex(npc, npc:level_vertex_id(), "varka_suppress")
end

local function emit_start(npc, n, w)
	local who = level.object_by_id(n.who)
	local wp = who and who:position() or w.pos
	emit(npc, "supp_start", { enemy = n.who, how = w.how, d = w.d, age = w.age, kind = w.kind, peeks = w.peeks,
	                          st = w.stance, err = math.sqrt((w.pos.x - wp.x) ^ 2 + (w.pos.z - wp.z) ^ 2),
	                          px = w.pos.x, py = w.pos.y, pz = w.pos.z, peek = w.back and 1 or 0 })
end

-- назад с огневой в укрытие, откуда вышел (тем же бегом, что «в укрытие от вести»)
local function go_home(s, now)
	if not s.home then return end
	s.cover, s.cover_pos, s.cover_t0 = s.home, s.home_pos, now
	s.home = nil
end

function act_varka_suppress:execute()
	action_base.execute(self)
	local npc = self.object
	if not npc:alive() then return end
	local id, now = npc:id(), time_global()
	local s, n = ctc[id], news[id]
	if not (s and n) then return end
	if s.nt ~= n.t then on_news(npc, s, n) end

	-- 1. в укрытие от вести
	if s.cover then
		if npc:position():distance_to_sqr(s.cover_pos) <= ARRIVE_SQR or now - s.cover_t0 > COVER_MS then
			s.cover = nil
			s.exposed = exposed_from(vector():set(n.x, n.y, n.z), npc:position())
		else
			state_mgr.set_state(npc, "assault", nil, nil, nil, { fast_set = true })
			utils_obj.send_to_nearest_accessible_vertex(npc, s.cover, "varka_suppress")
			return
		end
	end

	-- 1б. на огневую: дошёл (или не дошёл за PEEK_MS) — окно оттуда
	if s.out then
		if npc:position():distance_to_sqr(s.out.pos) <= ARRIVE_SQR or now - s.out.t0 > PEEK_MS then
			s.out, sup[id] = nil, nil
			local w, why = open_window(npc, n, now)
			if w then
				w.until_t, w.back = now + PEEK_WIN_MS, true
				s.win, sup[id] = w, w
				emit_start(npc, n, w)
				return
			end
			emit(npc, "ctc_peek_fail", { why = why })
			go_home(s, now)
		else
			state_mgr.set_state(npc, "assault", nil, nil, nil, { fast_set = true })
			utils_obj.send_to_nearest_accessible_vertex(npc, s.out.vid, "varka_suppress")
			return
		end
	end

	-- 2. окно огня: идёт — бить; кончилось — закрыть
	if s.win then
		if now < s.win.until_t then
			local fire = varka_aim.facing_point(npc, s.win.pos)
			if fire and not s.win.fired then
				s.win.fired = true
				emit(npc, "supp_fire", { ms = now - s.win.t0 })
			end
			varka_aim.trigger_point(npc, s.win.pos, fire)
			state_mgr.set_state(npc, s.win.stance == "stand" and "varka_aim_stand" or "varka_aim_crouch", nil, nil,
			                    { look_position = s.win.pos }, { fast_set = true })
			utils_obj.send_to_nearest_accessible_vertex(npc, npc:level_vertex_id(), "varka_suppress")
			return
		end
		local back = s.win.back
		close_window(npc, s, "done")
		if back then go_home(s, now); return end   -- «нырнул»: назад в укрытие
	end
	-- новая весть — открыть окно (не во время перезарядки)
	if done[id] ~= n.t and not s.rl and now - n.t >= REACT_MS and now >= (recheck[id] or 0) then
		recheck[id] = now + RECHECK_MS
		local w, why = open_window(npc, n, now)
		if w then
			done[id] = n.t
			s.win, sup[id] = w, w
			emit_start(npc, n, w)
			return
		end
		-- отсюда не достать — выйти на огневую («высунулся»), если весть свежая и в отряде есть место
		if (why == "land" or why == "no_edge") and now - n.t <= PEEK_AGE and now >= (s.peek_cd or 0)
		   and squad_taken(varka_lkp.get_squad_key(npc), id, n.who, now) < MAX_SQ then
			local P = vector():set(n.x, n.y - AIM_DOWN, n.z)
			local v, q = find_fire_spot(npc, P, land_r(n, npc:position():distance_to(P)))
			if v then
				done[id], s.peek_cd = n.t, now + PEEK_CD
				s.home, s.home_pos = npc:level_vertex_id(), npc:position()
				s.out = { vid = v, pos = q, t0 = now }
				sup[id] = { who = n.who, kind = "out", key = varka_lkp.get_squad_key(npc), until_t = now + PEEK_MS + PEEK_WIN_MS }
				emit(npc, "ctc_peek", { d = npc:position():distance_to(q), why = why })
				return
			end
			why = why .. "_nospot"
		end
		skip(npc, n.t, why)
		if why ~= "busy" and why ~= "mag" then done[id] = n.t end   -- ворота не откроются от ожидания
	end

	-- 3. держать: сидя, ствол на пик, перезарядка в укрытии
	hold(npc, s, now)
end

function act_varka_suppress:finalize()
	local npc = self.object
	local s = ctc[npc:id()]
	if s then
		local id, now = npc:id(), time_global()
		close_window(npc, s, "yield")
		if s.out then s.out, sup[id] = nil, nil end
		if s.rl and npc:alive() then   -- обнулили, а перезарядка не пошла — патроны назад
			local _, w = mag_frac(npc)
			if w and (w:get_ammo_in_magazine() or 0) == 0 and w:get_state() ~= WST_RELOAD then
				w:set_ammo_elapsed(s.rl.m); s.rl = nil
			end
		end
		emit(npc, "ctc_end", { ms = now - (s.t0 or now), why = why_end[id] or "planner" })
		why_end[id], seen_t[id] = nil, nil
		prev[id] = { s = s, t = now }
		ctc[id] = nil
	end
	varka_aim.release(npc)
	action_base.finalize(self)
end

-- Встраивание — после varka_cmd, varka_clear, varka_survive и varka_grenade: условия «граната / жить хочу /
-- приказ не активны» ссылаются на их оценщики, а условие на несуществующий оценщик — падение движка. Условие
-- «контакта нет» вешаем ТОЛЬКО на действия, которые у бойца точно есть (manager:action — lower_bound, см. varka_survive).
local function yield_ids(npc)
	local st = db.storage[npc:id()]
	local ids = { xr_actions_id.alife, xr_actions_id.state_mgr + 2, stalker_ids.action_combat_planner, stalker_ids.action_danger_planner }
	if st.varka_cmd_hooked then ids[#ids + 1] = 188202 end                              -- мягкий приказ
	if st.varka_clear_hooked then ids[#ids + 1] = 188210 end                            -- вера: заглянуть / держать край
	if st.rx_ff then ids[#ids + 1] = 18803 end                                           -- свой на линии
	if st.kill_wounded and xrs_kill_wounded and xrs_kill_wounded.is_enabled() then ids[#ids + 1] = 188112 end
	if st.fight_from_cover or st.axr_fight_from_cover then ids[#ids + 1] = 188118 end   -- бой из укрытия
	return ids
end

local function hook_npc(npc)
	local manager = npc:motivation_action_manager()
	if not manager then return end
	local st = db.storage[npc:id()]
	local wp = world_property
	manager:add_evaluator(EVA_SUPP, eva_varka_suppress("eva_varka_suppress"))
	local act = act_varka_suppress("act_varka_suppress")
	act:add_precondition(wp(stalker_ids.property_alive, true))
	act:add_precondition(wp(EVA_SUPP, true))
	if st.varka_survive_hooked then act:add_precondition(wp(EVA_SURV, false)) end
	if st.varka_grenade_hooked then act:add_precondition(wp(EVA_GRN, false)) end
	-- жёсткий приказ главнее; мягкий («идти к точке, бой важнее» — в матчах висит у всех) уступает, как вере.
	-- v0.2 требовал «мягкого нет» — в матчах действие было недостижимо: 36 окон открыто, ни одного выстрела.
	if st.varka_cmd_hooked then act:add_precondition(wp(EVA_HARD, false)) end
	act:add_effect(wp(EVA_SUPP, false))
	manager:add_action(ACT_SUPP, act)
	for _, id in ipairs(yield_ids(npc)) do
		local a = manager:action(id)
		if a then a:add_precondition(wp(EVA_SUPP, false)) end
	end
end

local function npc_update(npc)
	if varka_vanilla.is(npc) then return end  -- отряд «чистая ваниль»
	if not (npc and npc:alive() and IsStalker(npc)) then return end
	if character_community(npc) == "zombied" then return end
	local st = db.storage[npc:id()]
	-- флаг в db.storage: после офлайна боец приходит с новым планировщиком — встраиваемся заново
	if not st or st.varka_suppress_hooked then return end
	if varka_cmd and not st.varka_cmd_hooked then return end
	if varka_clear and not st.varka_clear_hooked then return end
	if varka_survive and not st.varka_survive_hooked then return end
	if varka_grenade and not st.varka_grenade_hooked then return end
	st.varka_suppress_hooked = true
	hook_npc(npc)
end

local function npc_death(npc)
	local id = npc:id()
	news[id], ctc[id], sup[id], done[id], recheck[id], skipped[id] = nil, nil, nil, nil, nil, nil
	prev[id], seen_t[id], why_end[id] = nil, nil, nil
end

function on_game_start()
	RegisterScriptCallback("npc_on_update", npc_update)
	RegisterScriptCallback("npc_on_hear_callback", on_hear)
	RegisterScriptCallback("npc_on_death_callback", npc_death)
end
