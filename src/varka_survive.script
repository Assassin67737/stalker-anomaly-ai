-- varka_survive.script — «ЖИТЬ ХОЧУ» (23.10.2026): боец не располагает своей жизнью глупо
--
-- Юзер 23.10: «НПС слишком туннелируются на одного… если по нему палят, пусть меняет приоритет; а в идеале —
-- не располагать своей жизнью так глупо. После этого бои станут засидчивее — и тогда марш-броски и командные
-- прорывы будут смотреться». Замер 134 смертей (три серии Агропрома 22–23.10): 49 убиты НЕ тем, в кого целились;
-- 66 перед смертельным уже получили пулю (за 10 с) и ничего не поменяли; 85 за последние 5 с шли больше 3 м.
--
-- Две части:
--
-- 1. ФОКУС НА СТРЕЛКА. Движок выбирает цель минимумом счёта (enemy_manager.cpp): видимый −1000, «меня видит»
--    −300, «последний, кто меня ранил» — всего −5 ближе 30 м. Стрелок сбоку почти не перевешивает того, в кого
--    уже смотришь. Рычаг из Lua один — колбэк «полезен ли враг» (xr_combat_ignore.action_process_enemy.
--    enemy_callback): ранил ДРУГОЙ враг → FOCUS_MS остальные «бесполезны», цель — он. В упор (текущая цель
--    ближе CQB_M, стрелок дальше) не дёргаемся. npc:set_enemy для сталкера не работает (в движке только
--    кровосос) — поэтому колбэк.
--
-- 2. РЫВОК ИЗ-ПОД ВЗГЛЯДА. Попали, и стрелок меня видит → ближайшая нода в 2–8 м, где присевшего не видно ни
--    стрелку, ни другим врагам в памяти (v0.4, «укрытие глазами движка» ниже), — бегом туда, присесть и пересидеть HOLD_MS (дольше, если
--    мало здоровья). Видно врага с места — бить сидя. Действие — в ГЛАВНОМ планировщике (своё только туда,
--    см. PLANNER_MAP), главнее боя, веры, приказов и добивания. Граната рядом / ранен лежит — уступаем.
--    Места нет (голое поле) — ничего не делаем, пусть ваниль. После — RETRY_MS без нового рывка, чтобы не
--    прятаться вечно от одной очереди.
--
-- 3. ПЕРЕЗАРЯДКА ЗА УКРЫТИЕМ (26.10, юзер: «никто не станет перезаряжаться стоя в поле, когда рядом есть немалый
--    булыжник»). Магазин пуст или почти, а враг на виду → спринтом (ствол за спиной) к ближайшей ноде, которую с
--    его глаз не видно (тот же поиск, что у рывка, но дальше — до 14 м), там присесть, достать ствол и перезарядиться.
--    Неполный магазин меняется целиком (команды «перезарядить» из Lua нет — см. varka_weapons.top_up). Врага не
--    видно — бежать незачем: меняют на месте (top_up). Места нет — ваниль (перезарядка, где стоит).
--    v0.3 (25.10, ночь 042936): спринт («ствол за спиной», state_lib sprint = weapon "strapped») ломал ствол —
--    убран посреди очереди/перезарядки, движок его больше не перезаряжал: 36 из 600 бойцов VARKA ходили с пустым
--    магазином ≥15 с (ваниль — 1 из 600), 35 из них — после перезарядки за укрытием. Теперь бег «assault» (ствол
--    в руках, как у рывка — ни одной поломки). Страховка: в укрытии магазин пуст RELOAD_EMPTY_MS, а ствол не
--    перезаряжается — патроны назад, отдаём ванили (хуже ванили не станет). Дробовики — только с пустым
--    магазином и без обнуления (набивка по патрону); конец — магазин полон или перестал расти RELOAD_SETTLE.
--
-- id: 188211 оценщик, 188212 действие.

local EVA_SURV, ACT_SURV = 188211, 188212
local FOCUS_MS = 4000
local CQB_M    = 6
local HOLD_MS  = 3500       -- пересидеть: основа, + до HOLD_HURT при пустом здоровье
local HOLD_HURT = 5000
local RUN_MS   = 4000       -- не добежал за это время — бросаем
local RETRY_MS = 3000
local DIRS     = 12
local RINGS    = { 2, 4, 6, 8 }
local EYE = 1.6              -- глаза врага над ногами
local RQT_STATIC = 2
local VIS_THR = 0.6          -- [stalker_vision_danger] transparency_threshold, перечитывается из ltx в on_game_start
-- присевший: голова, грудь по ширине плеч; ±0.55 — запас: боец встаёт не точно в центр ноды (клетка 0.7 м)
local BODY = { { 1.1, 0 }, { 0.75, 0 }, { 0.75, 0.25 }, { 0.75, -0.25 }, { 0.75, 0.55 }, { 0.75, -0.55 } }
local THREAT_MEM = 10000     -- враг в памяти глазами не старше этого — тоже угроза
local THREAT_R   = 100
local THREAT_MAX = 4         -- стрелок + до трёх ближайших
local RAY_CAP    = 1500      -- предохранитель на один поиск: больше лучей — берём, что нашли
local RELOAD_FRAC   = 0.34                     -- магазин меньше этой доли (или пуст) и враг на виду — за укрытие
local RELOAD_RINGS  = { 2, 4, 6, 8, 11, 14 }   -- дальше, чем от пули: 14 м спринтом ≈ 2.5 с
local RELOAD_RUN_MS = 6000
local RELOAD_MAX    = 8000                     -- пересидеть не дольше (пулемёт перезаряжается ~5 с)
local RELOAD_TICK   = 300
local RELOAD_EMPTY_MS = 2500   -- в укрытии магазин пуст столько и ствол не в перезарядке — сдаёмся
local RELOAD_SETTLE   = 1000   -- магазин вырос и не меняется столько — перезарядка кончилась (дробовик, неполный)
local RELOAD_RETRY_EMPTY = 10000  -- после сдачи столько без новой пробежки: пусть ваниль перезарядит
local SHELL_MS      = 700      -- дробовик: на патрон
local WST_RELOAD    = 7        -- CWeapon::eReload (HudItem.h / Weapon.h: idle 0 … fire 5, fire2 6, reload 7)

local function emit(npc, ev, f)
	if varka_trace then varka_trace.emit(varka_lkp and varka_lkp.get_squad_key(npc) or 0, npc:id(), ev, f) end
end

-- ─── 1. фокус ────────────────────────────────────────────────────────────────────────
local focus = {}  -- id бойца → { id = стрелок, t = до какого времени }

local function focus_blocks(npc, enemy)
	local f = focus[npc:id()]
	if not f or enemy:id() == f.id then return false end
	if time_global() > f.t then focus[npc:id()] = nil; return false end
	local s = level.object_by_id(f.id)
	if not (s and s:alive()) then focus[npc:id()] = nil; return false end
	return true
end

local function patch_enemy_callback()
	local cls = xr_combat_ignore and xr_combat_ignore.action_process_enemy
	if not cls or cls.varka_focus then return end
	local base = cls.enemy_callback
	cls.enemy_callback = function(self, npc, enemy)
		local ok = base(self, npc, enemy)
		if ok and focus_blocks(npc, enemy) then return false end
		return ok
	end
	cls.varka_focus = true
end

-- ─── 2. рывок ────────────────────────────────────────────────────────────────────────
-- Укрытие глазами движка (v0.4, 25.10). Аудит на Армейках (1.17 млн пар «точка — враг»): старый поиск — один луч
-- в голову, любой треугольник — давал место, где присевшего реально не видно, в 36% случаев, при трёх врагах в 2%.
-- Чинили по одной причине: тело вместо точки +25 п.п., материалы +12, все угрозы +10 (при трёх), запас +4.
-- Здесь всё сразу; на стенде 78% / 30%. Как глаза движка (Feel_Vision): луч ОТ врага, ray_pick видит только
-- лицевые грани (OPT_CULL, xr_area_raypick.cpp) — изнанку стены и не надо ловить; проницаемость материалов
-- перемножается, пока не упадёт до порога боевого зрения (куст 0.7 взгляд пропускает, два куста — нет).
-- Только статика уровня: ящики и машины, которые двигает физика, не закрывают.
local rp, nray

-- видно ли точку p с глаз eye
local function seen(eye, p)
	local dir = vector():set(p):sub(eye)
	local left = dir:magnitude()
	if left < 0.3 then return true end
	dir:normalize()
	local from, pass = vector():set(eye), 1
	for _ = 1, 6 do   -- больше шести слоёв подряд — считаем стеной
		rp:set_position(from); rp:set_direction(dir); rp:set_range(left)
		nray = nray + 1
		if not rp:query() then return true end
		local hit = rp:get_distance()
		if hit >= left - 0.05 then return true end
		pass = pass * rp:get_result().material_vis_transparency_factor
		if pass <= VIS_THR then return false end
		from:mad(dir, hit + 0.02); left = left - hit - 0.02   -- сквозь прозрачное — дальше
	end
	return false
end

-- присевший на p закрыт от глаз eye целиком: ни голова, ни грудь, ни плечи с запасом
local function body_hidden(p, eye)
	local side = vector():set(p):sub(eye)
	side = vector():set(-side.z, 0, side.x)   -- поперёк линии взгляда, по земле
	if side:magnitude() < 0.01 then return false end
	side:normalize()
	for _, b in ipairs(BODY) do
		local q = vector():set(p):mad(side, b[2]); q.y = q.y + b[1]
		if seen(eye, q) then return false end
	end
	return true
end

-- глаза угроз: стрелок (он только что стрелял — где он, известно) + враги, которых боец недавно видел,
-- там, где он их помнит (memory_position — его вера, не правда)
local function threat_eyes(npc, shooter)
	local now, pos, more = time_global(), npc:position(), {}
	for o in npc:memory_visible_objects() do
		local e = o and o:object()
		if e and e:id() ~= shooter:id() and IsStalker(e) and e:alive() and npc:relation(e) == game_object.enemy then
			local mt = npc:memory_time(e)
			if mt and mt > 0 and now - mt < THREAT_MEM then
				local mp = npc:memory_position(e)
				local d = mp:distance_to(pos)
				if d < THREAT_R then more[#more + 1] = { p = vector():set(mp), d = d } end
			end
		end
	end
	table.sort(more, function(a, b) return a.d < b.d end)
	local eyes = { vector():set(shooter:position()) }
	for i = 1, math.min(#more, THREAT_MAX - 1) do eyes[#eyes + 1] = more[i].p end
	for _, e in ipairs(eyes) do e.y = e.y + EYE end
	return eyes
end

-- ближайшая нода, где присевшего не видно ни одной угрозе. Такой нет — где не видно хотя бы стрелку и меньше
-- всего остальным (part = 1 в trace): спрятаться от всех часто негде, а от того, кто попал, — лучше, чем стоять.
local function hide_spot(npc, shooter, rings)
	if not rp then rp = ray_pick(); rp:set_flags(RQT_STATIC) end
	nray = 0
	local pt = profile_timer(); pt:start()
	local eyes = threat_eyes(npc, shooter)
	local base = npc:level_vertex_id()
	local away = vector():set(npc:position()):sub(shooter:position()); away.y = 0
	if away:magnitude() < 0.1 then away = vector():set(1, 0, 0) end
	away:normalize()
	local best, best_s, part, part_s
	for _, r in ipairs(rings or RINGS) do
		for i = 0, DIRS - 1 do
			if nray > RAY_CAP then break end
			local dir = vector_rotate_y(vector():set(away), i * 360 / DIRS)
			local v = level.vertex_in_direction(base, dir, r)
			if v and v < 4294967295 and v ~= base and npc:accessible(v)
				and (not db.used_level_vertex_ids or not db.used_level_vertex_ids[v]) then
				local p = level.vertex_position(v)
				if body_hidden(p, eyes[1]) then
					-- короче лучше; к стрелку — хуже (выбегать на него не надо)
					local s = r + 2 * math.max(0, dir:dotproduct(vector():set(0, 0, 0):sub(away)))
					local open = 0   -- скольким остальным виден
					for k = 2, #eyes do
						if not body_hidden(p, eyes[k]) then open = open + 1 end
					end
					if open == 0 then
						if not best_s or s < best_s then best, best_s = v, s end
					elseif not best then
						s = s + 100 * open
						if not part_s or s < part_s then part, part_s = v, s end
					end
				end
			end
		end
		if best then break end   -- нашлось на этом кольце — дальше не бежим
	end
	pt:stop()
	local info = { rays = nray, us = math.floor(pt:time()), n = #eyes,
		part = (not best and part) and 1 or nil, cap = nray > RAY_CAP and 1 or nil }
	return best or part, info
end

local surv = {}  -- id бойца → { shooter, vid, phase = "run"|"hold", t0, until }

-- 24.10 (бой 225832-3, 8884 с обрезом): ближний враг в 5 м лупил по нему очередями мимо, а цель так и осталась
-- дальней (62 м) — движок даёт очки за «вижу», «меня видит», «ранил меня», но не за «стреляет в меня».
-- Очередь в упор слышно и чувствуется кожей: стреляет В МЕНЯ ближе NEAR_SHOT_M, а моя цель заметно дальше —
-- фокус на него, как от попадания. Только если стрелок уже в памяти (иначе фокус обнулит все цели).
local NEAR_SHOT_M, NEAR_SHOT_GAP, NEAR_SHOT_MEM = 15, 10, 3000
function shot_at(npc, who)
	if not (npc and npc:alive() and who and IsStalker(npc)) then return end
	local be = npc:best_enemy()
	if not be or be:id() == who:id() then return end
	local f = focus[npc:id()]
	if f and f.id == who:id() and time_global() < f.t then return end
	local p = npc:position()
	local dw, db_ = who:position():distance_to(p), be:position():distance_to(p)
	if dw > NEAR_SHOT_M or db_ < dw + NEAR_SHOT_GAP then return end
	local seen = npc:memory_time(who)
	if not (seen and seen > 0 and time_global() - seen < NEAR_SHOT_MEM) then return end
	focus[npc:id()] = { id = who:id(), t = time_global() + FOCUS_MS }
	emit(npc, "focus", { who = who:id(), was = be:id(), why = "shot" })
end

local function on_hit(npc, amount, dir, who, bone)
	if varka_vanilla.is(npc) then return end  -- 25.10: отряд «чистая ваниль»
	if not (npc and npc:alive() and who and amount and amount > 0) then return end
	if not (IsStalker(who) and who:alive() and who:id() ~= npc:id()) then return end
	if npc:relation(who) ~= game_object.enemy then return end
	local id, now = npc:id(), time_global()

	-- фокус: ранил не тот, в кого смотрю
	local be = npc:best_enemy()
	if be and be:id() ~= who:id() then
		local close = be:position():distance_to(npc:position()) < CQB_M and who:position():distance_to(npc:position()) > CQB_M
		if not close then
			focus[id] = { id = who:id(), t = now + FOCUS_MS }
			emit(npc, "focus", { who = who:id(), was = be:id() })
		end
	end

	-- рывок: стрелок меня видит, рывка сейчас нет и пауза после прошлого прошла
	local s = surv[id]
	if s and (s.phase or now < (s.retry or 0)) then return end
	if not who:see(npc) or IsWounded(npc) then return end
	local v, info = hide_spot(npc, who)
	if not v then emit(npc, "survive_none", { who = who:id(), n = info.n, rays = info.rays, us = info.us, cap = info.cap }); return end
	local hp = npc.health or 1
	surv[id] = { shooter = who:id(), vid = v, phase = "run", t0 = now,
		hold = HOLD_MS + HOLD_HURT * (1 - math.max(0, math.min(1, hp))) }
	emit(npc, "survive", { who = who:id(), vid = v, d = npc:position():distance_to(level.vertex_position(v)), hp = hp,
		n = info.n, part = info.part, rays = info.rays, us = info.us, cap = info.cap })
end

-- магазин в руках: патронов, ёмкость, ствол (нет огнестрела — nil)
local function mag_of(npc)
	local w = npc:active_item()
	if not (w and IsWeapon(w) and not IsMelee(w)) then return end
	local size = ini_sys:r_float_ex(w:section(), "ammo_mag_size") or 0
	if size < 1 then return end
	return (w:get_ammo_in_magazine() or 0), size, w
end

local next_check = {}  -- id бойца → когда снова смотреть магазин
local function reload_check(npc)
	local id, now = npc:id(), time_global()
	if now < (next_check[id] or 0) then return end
	next_check[id] = now + RELOAD_TICK
	local s = surv[id]
	if s and (s.phase or now < (s.retry or 0)) then return end
	local be = npc:best_enemy()
	if not (be and npc:see(be)) or IsWounded(npc) then return end
	local m, size, w = mag_of(npc)
	if not m or m >= size * RELOAD_FRAC then return end
	local shells = ini_sys:r_string_ex(w:section(), "kind") == "w_shotgun"
	if shells and m > 0 then return end   -- набивку по патрону движок начинает только с пустого
	local bd = npc:best_danger()
	if bd and bd:type() == danger_object.grenade then return end
	local v, info = hide_spot(npc, be, RELOAD_RINGS)
	if not v then
		emit(npc, "reload_none", { mag = m, n = info.n, rays = info.rays, us = info.us, cap = info.cap })
		next_check[id] = now + 2000
		return
	end
	surv[id] = { shooter = be:id(), vid = v, phase = "run", t0 = now, reload = true, shells = shells,
		hold = shells and math.max(RELOAD_MAX, 1500 + size * SHELL_MS) or RELOAD_MAX }
	emit(npc, "reload_run", { who = be:id(), vid = v, mag = m, size = size, wst = w:get_state(),
		d = npc:position():distance_to(level.vertex_position(v)),
		n = info.n, part = info.part, rays = info.rays, us = info.us, cap = info.cap })
end

local function finish(npc, why, f)
	local s = surv[npc:id()]
	if not s or not s.phase then return end
	s.phase, s.retry = nil, time_global() + RETRY_MS
	f = f or {}
	f.why = why
	if s.reload and npc:alive() then f.mag = (mag_of(npc)) end
	emit(npc, "survive_end", f)
end

class "eva_varka_survive" (property_evaluator)
function eva_varka_survive:__init(name) super(nil, name) end
function eva_varka_survive:evaluate()
	local npc = self.object
	local s = surv[npc:id()]
	if not (s and s.phase) then return false end
	if not npc:alive() or IsWounded(npc) then finish(npc, "wounded"); return false end
	local bd = npc:best_danger()
	if bd and bd:type() == danger_object.grenade then finish(npc, "grenade"); return false end
	local now = time_global()
	if s.phase == "run" and now - s.t0 > (s.reload and RELOAD_RUN_MS or RUN_MS) then finish(npc, "stuck"); return false end
	if s.reload and s.phase == "hold" and now - s.hold_t0 > 600 then
		local m, size, w = mag_of(npc)
		if m then
			if m ~= s.last_m then s.last_m, s.last_mt = m, now end
			if m >= size or (m > (s.m0 or 0) and now - s.last_mt > RELOAD_SETTLE) then finish(npc, "reloaded"); return false end
			local wst = w:get_state()
			if m == 0 and wst ~= WST_RELOAD and now - s.last_mt > RELOAD_EMPTY_MS then
				if (s.saved or 0) > 0 then w:set_ammo_elapsed(s.saved) end  -- обнуляли мы — патроны назад
				finish(npc, "empty", { wst = wst, back = s.saved or 0 })
				s.retry = now + RELOAD_RETRY_EMPTY
				return false
			end
		end
	end
	if s.phase == "hold" and now > s.hold_until then finish(npc, "rested"); return false end
	return true
end

class "act_varka_survive" (action_base)
function act_varka_survive:__init(name) super(nil, name) end
function act_varka_survive:initialize()
	action_base.initialize(self)
	self.object:set_path_type(game_object.level_path)
end
function act_varka_survive:execute()
	action_base.execute(self)
	local npc = self.object
	if not npc:alive() then return end
	local s = surv[npc:id()]
	if not (s and s.phase) then return end
	local shooter = level.object_by_id(s.shooter)
	local spot = level.vertex_position(s.vid)
	if s.phase == "run" then
		if npc:position():distance_to_sqr(spot) > 1.0 then
			-- бегом, ствол наготове, взгляд — по ходу (смотреть на стрелка на бегу = подставляться дольше)
			-- v0.3: и на перезарядку — «assault», не «sprint»: спринт убирает ствол за спину и ломал перезарядку
			state_mgr.set_state(npc, "assault", nil, nil, nil)
			utils_obj.send_to_nearest_accessible_vertex(npc, s.vid, "varka_survive")
			return
		end
		s.phase, s.hold_until, s.hold_t0 = "hold", time_global() + s.hold, time_global()
		local wst
		if s.reload then  -- неполный магазин — сменить целиком: обнулить, движок перезарядит, как только ствол поднят
			local m, size, w = mag_of(npc)
			if m and m > 0 and m < size and not s.shells then w:set_ammo_elapsed(0); s.saved, m = m, 0 end
			s.m0, wst = m, w and w:get_state()
		end
		emit(npc, "survive_hold", { ms = math.floor(s.hold), reload = s.reload and 1 or 0, wst = wst, saved = s.saved })
	end
	-- пересидеть: сидя; виден враг — бить через ворота огня (довернулся, ствол свободен сидя/стоя — varka_aim),
	-- нет — ствол туда, где был стрелок
	local be = npc:best_enemy()
	if be and npc:see(be) then
		local wpn = npc:active_item()
		local sniper = wpn and IsWeapon(wpn) and ini_sys:r_string_ex(wpn:section(), "kind") == "w_sniper"
		state_mgr.set_state(npc, (varka_aim.hold_state(npc, be, sniper, true)), nil, nil, { look_object = be })
	else
		state_mgr.set_state(npc, varka_aim.wait_state(npc), nil, nil, shooter and { look_position = shooter:position() } or nil)
	end
	utils_obj.send_to_nearest_accessible_vertex(npc, s.vid, "varka_survive")
end
function act_varka_survive:finalize()
	finish(self.object, "yield")
	varka_aim.release(self.object)
	action_base.finalize(self)
end

-- Встраивание — после varka_cmd и varka_clear. Условие вешаем ТОЛЬКО на действия, которые у бойца точно есть:
-- manager:action(id) ищет lower_bound (problem_solver_inline.h) — нет такого id, и вернётся СЛЕДУЮЩЕЕ по номеру
-- действие, условие повиснет не туда. Наличие ванильных схем — по их хранилищу (assign_storage_and_bind).
local function yield_ids(npc)
	local st = db.storage[npc:id()]
	local ids = { xr_actions_id.alife, xr_actions_id.state_mgr + 2, stalker_ids.action_combat_planner, stalker_ids.action_danger_planner }
	if st.varka_cmd_hooked then ids[#ids + 1] = 188202; ids[#ids + 1] = 188204 end    -- приказы мягкий / жёсткий
	if st.varka_clear_hooked then ids[#ids + 1] = 188210 end                            -- вера: заглянуть / держать край
	if st.rx_ff then ids[#ids + 1] = 18803 end                                           -- свой на линии
	if st.kill_wounded and xrs_kill_wounded and xrs_kill_wounded.is_enabled() then ids[#ids + 1] = 188112 end
	if st.fight_from_cover or st.axr_fight_from_cover then ids[#ids + 1] = 188118 end                              -- бой из укрытия
	return ids
end
local function hook_npc(npc)
	local manager = npc:motivation_action_manager()
	if not manager then return end
	local wp = world_property
	manager:add_evaluator(EVA_SURV, eva_varka_survive("eva_varka_survive"))
	local act = act_varka_survive("act_varka_survive")
	act:add_precondition(wp(stalker_ids.property_alive, true))
	act:add_precondition(wp(EVA_SURV, true))
	act:add_effect(wp(EVA_SURV, false))
	manager:add_action(ACT_SURV, act)
	for _, id in ipairs(yield_ids(npc)) do
		local a = manager:action(id)
		if a then a:add_precondition(wp(EVA_SURV, false)) end
	end
end

local function npc_update(npc)
	if varka_vanilla.is(npc) then return end  -- 25.10: отряд «чистая ваниль»
	if not (npc and npc:alive() and IsStalker(npc)) then return end
	if character_community(npc) == "zombied" then return end
	local st = db.storage[npc:id()]
	if not st then return end
	if st.varka_survive_hooked then reload_check(npc); return end
	if varka_clear and not st.varka_clear_hooked then return end
	if varka_cmd and not st.varka_cmd_hooked then return end
	st.varka_survive_hooked = true
	hook_npc(npc)
end

local function on_death(npc)
	if npc then surv[npc:id()] = nil; focus[npc:id()] = nil; next_check[npc:id()] = nil end
end

function on_game_start()
	VIS_THR = ini_sys:r_float_ex("stalker_vision_danger", "transparency_threshold") or VIS_THR
	patch_enemy_callback()
	RegisterScriptCallback("npc_on_update", npc_update)
	RegisterScriptCallback("npc_on_hit_callback", on_hit)
	RegisterScriptCallback("npc_on_death_callback", on_death)
end
