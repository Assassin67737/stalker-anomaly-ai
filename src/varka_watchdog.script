-- varka_watchdog.script — err != nil: ловит тихий откат к ванили
--
-- Инвариант: если belief ИЛИ echo живы для отряда NPC → наш action должен рулить.
-- Если не рулит (varka_active = nil) → тихий обрыв инфры. Кричим и замораживаем.
--
-- Это НЕ поведение. Это ассерт. Живёт вне GOAP — переживает закрытие любого планировщика.
-- Аналог: if err != nil { log; freeze }

local TICK_MS = 2000  -- раз в 2с на NPC (не каждый фрейм)
local last_tick = {}

local function watch(npc)
    if not (npc and npc:alive() and IsStalker(npc)) then return end
    local id  = npc:id()
    local now = time_global()
    if (now - (last_tick[id] or 0)) < TICK_MS then return end
    last_tick[id] = now

    -- инфра жива?
    local b = varka_lkp.get_belief(npc)
    local e = varka_lkp.get_echo(npc)
    if not b and not e then return end  -- нет инфры — ваниль правит честно, молчим

    -- наш action рулит?
    local st = db.storage[id]
    if st and st.varka_active then return end  -- всё ок
    -- ваниль рулит ЗАКОННО: ранен/сдаётся (схема раненого) — не обрыв
    if IsWounded(npc) then return end
    -- ваниль рулит ЗАКОННО: враг в памяти — идёт ванильный бой. Наш поиск берёт только окно, когда
    -- врага в памяти уже нет (условие pure_enemy=false). 21.10: без этой строки — 1049 ложных
    -- тревог за 4 матча (10% всего trace).
    if npc:best_enemy() then return end

    -- ИНФРА ЖИВА, НАШ ACTION НЕ АКТИВЕН → тихий обрыв (или ванильный бой: враг в глазах)
    -- v0.18: ТОЛЬКО ассерт — лог + трейс. Раньше тут был set_body_state(stand) раз в 2с:
    -- поднимал раненых, которых схема раненого тут же клала обратно («вставай-ложись»,
    -- полигон 19.10: 1753 срабатывания + ~600 «error in stalker with visual»).
    if varka_trace then
        local sq = varka_lkp.get_squad_key(npc)
        varka_trace.emit(sq, id, "watch_lost", {bel=b ~= nil, echo=e ~= nil})
    end
    printf("VARKA-WATCH: npc %s — infra alive (belief=%s echo=%s) but control lost",
        tostring(id), tostring(b ~= nil), tostring(e ~= nil))
end

local function npc_death(npc)
    if npc then last_tick[npc:id()] = nil end
end

function on_game_start()
    RegisterScriptCallback("npc_on_update",         watch)
    RegisterScriptCallback("npc_on_death_callback", npc_death)
end
