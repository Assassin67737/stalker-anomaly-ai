-- varka_weapons.script — v0.1: выбор ствола по дистанции с гистерезисом (20.10.2026)
--
-- Как в Anomaly: движок спрашивает Lua (_g.update_best_weapon → колбэк npc_on_choose_weapon),
-- а если никто не ответил — сам пересчитывает «эффективность» всех стволов КАЖДЫЙ раз. Проверку
-- «держи текущий» Alundaio из движка вырезал (ai_stalker_fire.cpp). Два похожих ствола → числа
-- почти равны → лучший прыгает туда-обратно → боец жонглирует оружием прямо в контакте
-- (полигон 20.10: подобрал второй автомат — и вместо стрельбы смена за сменой).
--
-- Здесь: у каждого класса своя рабочая дистанция; ствол меняется, только если новый заметно лучше
-- на текущей дистанции до врага И с прошлой смены прошло SWITCH_HOLD. Пустой магазин — минус.
-- Без врага — держим, что в руках. Если оружие вообще одно — это не лечится: обрез с дробью на
-- 100 м — задача дирижёра (роль ближнего боя), не этого скрипта.

local DEBUG       = true
local SWITCH_HOLD = 8000   -- мс между сменами
local MARGIN      = 0.3    -- насколько новый должен быть лучше
local CACHE_MS    = 500    -- движок спрашивает часто; считаем не чаще

-- рабочая дистанция класса, м: {ближе — хуже, идеал от, идеал до, дальше — хуже}
local RANGE = {
	w_pistol  = { 0, 0, 20, 45 },
	w_smg     = { 0, 0, 30, 60 },
	w_shotgun = { 0, 0, 15, 35 },
	w_rifle   = { 3, 8, 120, 250 },
	w_sniper  = { 15, 40, 400, 800 },
	launcher  = { 20, 35, 150, 300 },
}

local state = {}  -- [npc_id] = { id = выбранный ствол, since, check }

local function kind_of(wpn)
	local k = ini_sys:r_string_ex(wpn:section(), "kind")
	if RANGE[k] then return k end
	local cls = wpn:clsid()
	if IsLauncher and IsLauncher(nil, cls) then return "launcher" end
	if IsSniper(nil, cls) then return "w_sniper" end
	if IsShotgun(nil, cls) then return "w_shotgun" end
	if IsPistol(nil, cls) then return "w_pistol" end
	return "w_rifle"
end

-- 0..1: насколько класс хорош на дистанции d
local function fit(kind, d)
	local r = RANGE[kind] or RANGE.w_rifle
	if d < r[2] then return r[2] <= r[1] and 1 or math.max(0, (d - r[1]) / (r[2] - r[1])) end
	if d <= r[3] then return 1 end
	if d >= r[4] then return 0 end
	return 1 - (d - r[3]) / (r[4] - r[3])
end

local function score(wpn, d)
	local s = fit(kind_of(wpn), d)
	if wpn.get_ammo_in_magazine and wpn:get_ammo_in_magazine() == 0 then s = s - 0.5 end
	return s
end

local function choose(npc, cur_wpn, flags)
	if not (npc and npc:alive()) then return end
	local id, now = npc:id(), time_global()
	local st = state[id]
	if not st then st = { since = 0, check = 0 }; state[id] = st end

	-- кэш: пока свежо — отвечаем тем же
	if now < st.check and st.id then
		local o = level.object_by_id(st.id)
		if o and o:parent() and o:parent():id() == id then flags.gun_id = st.id end
		return
	end
	st.check = now + CACHE_MS

	local be = npc:best_enemy()
	local cur = cur_wpn and IsWeapon(cur_wpn) and cur_wpn or nil
	if not be then  -- без врага не дёргаемся
		st.id = cur and cur:id() or st.id
		if st.id then flags.gun_id = st.id end
		return
	end

	local d = npc:position():distance_to(be:position())
	local best, best_s = nil, -1
	npc:iterate_inventory(function(_, item)
		if IsWeapon(item) and not IsMelee(item) and not IsGrenade(item) then
			local s = score(item, d)
			if s > best_s then best, best_s = item, s end
		end
	end, npc)
	if not best then return end

	local cur_s = cur and score(cur, d) or -1
	local keep = cur and best:id() ~= cur:id()
		and (best_s < cur_s + MARGIN or now - st.since < SWITCH_HOLD)
		and cur_s > -0.4                       -- текущий не пустой — терпим
	local pick = keep and cur or best
	if not cur or pick:id() ~= cur:id() then
		st.since = now
		if varka_trace then
			varka_trace.emit(0, id, "wpn_switch", { from = cur and cur:section() or "", to = pick:section(),
				d = d, s_from = cur_s, s_to = score(pick, d) })
		end
	end
	st.id = pick:id()
	flags.gun_id = st.id
end

local function npc_death(npc)
	if npc then state[npc:id()] = nil end
end

function on_game_start()
	RegisterScriptCallback("npc_on_choose_weapon", choose)
	RegisterScriptCallback("npc_on_death_callback", npc_death)
end
