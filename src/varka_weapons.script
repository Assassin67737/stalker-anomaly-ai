-- varka_weapons.script — v0.5: болтовка вблизи — по рангу (21.10.2026, идея юзера)
-- v0.5: полигон 21.10 (Монолит с СКС на Свалке) — СКС числится снайперкой (kind = w_sniper), а снайперке
--   ближе 40 м шёл минус: на ~21 м брал пистолет, на ~33 м обратно, раз в 8 с. Но СКС — самозарядка.
--   Теперь: снайперка с rpm > BOLT_RPM — «марксманка» (w_marksman, вблизи не хуже автомата).
--   Настоящая болтовка вблизи — по рангу: новичок заранее (враг ближе BOLT_NEAR × (1 − навык)) меняет
--   на запасной ствол; мастер и легенда сначала стреляют патроном из патронника и сразу, не передёргивая,
--   берут запасной. Обратно на болтовку — когда враг дальше BOLT_FAR.
-- v0.4: патроны у сталкеров бесконечны — пустой магазин = перезарядка (21.10.2026)
-- v0.4: полигон 21.10 (Долг против ренегатов) — пистолеты на 75 м. Причина: сталкеры воюют с
--   бесконечными патронами (движок: eTraderFlagInfiniteAmmo у всех сталкеров, перезарядка сама
--   досоздаёт патроны, коробок в рюкзаке нет — они появляются только на трупе). Проверка «есть ли
--   запасные патроны» всегда отвечала «нет» → каждая перезарядка выглядела как «патроны кончились»
--   → смена на пистолет на любой дистанции. Пустой магазин больше не минус вообще.
-- v0.3: «последний довод» — пистолет, когда перезаряжаться негде (21.10.2026)
-- v0.2: перезарядка вместо смены, пистолет — запасной (21.10.2026)
-- v0.2: полигон 21.10 — бойцы меняли автомат на пистолет на 4–13 м и так и воевали (экологи — почти
--   весь бой). Две причины: пустой магазин давал −0.5 (вместо перезарядки — смена на пистолет), а
--   на ближней дистанции пистолет был «не хуже» автомата, и гистерезис держал его. Теперь пустой
--   магазин — минус, только если запасных патронов нет; у класса есть мощность (POWER).
-- v0.1: выбор ствола по дистанции с гистерезисом (20.10.2026)
--
-- Как в Anomaly: движок спрашивает Lua (_g.update_best_weapon → колбэк npc_on_choose_weapon),
-- а если никто не ответил — сам пересчитывает «эффективность» всех стволов КАЖДЫЙ раз. Проверку
-- «держи текущий» Alundaio из движка вырезал (ai_stalker_fire.cpp). Два похожих ствола → числа
-- почти равны → лучший прыгает туда-обратно → боец жонглирует оружием прямо в контакте
-- (полигон 20.10: подобрал второй автомат — и вместо стрельбы смена за сменой).
--
-- Здесь: у каждого класса своя рабочая дистанция; ствол меняется, только если новый заметно лучше
-- на текущей дистанции до врага И с прошлой смены прошло SWITCH_HOLD. Пустой магазин — не минус (v0.4).
-- Без врага — держим, что в руках. Если оружие вообще одно — это не лечится: обрез с дробью на
-- 100 м — задача дирижёра (роль ближнего боя), не этого скрипта.

local DEBUG       = true
local SWITCH_HOLD = 8000   -- мс между сменами
local MARGIN      = 0.3    -- насколько новый должен быть лучше
local CACHE_MS    = 500    -- движок спрашивает часто; считаем не чаще

-- рабочая дистанция класса, м: {ближе — хуже, идеал от, идеал до, дальше — хуже}
local RANGE = {
	w_pistol  = { 0, 0, 20, 45 },
	w_smg     = { 0, 0, 30, 60 },
	w_shotgun = { 0, 0, 15, 35 },
	w_rifle   = { 0, 0, 120, 250 },
	w_marksman = { 0, 0, 150, 400 },  -- v0.5: самозарядная снайперка (СВД, СКС, СВТ, SR-25)
	w_sniper  = { 0, 0, 400, 800 },   -- v0.5: болтовка; вблизи решает правило болтовки, не счёт
	launcher  = { 20, 35, 150, 300 },
}

-- мощность класса: при равной дистанции автомат лучше пистолета; пистолет — запасной ствол
local POWER = {
	w_pistol  = 0.6,
	w_smg     = 0.85,
	w_shotgun = 1,
	w_rifle   = 1,
	w_marksman = 1,
	w_sniper  = 1,
	launcher  = 1,
}

-- v0.5: болтовка. rpm в ltx: M24 20, Мосин 25, K98 28, SV-98 30, Remington 700 40 — затвор ручной;
-- самозарядки от 60 (СВД 60, СВУ 70, СВТ 150, СКС 200). WA2000 (45) — самозарядка, порог её отсекает.
local BOLT_RPM  = 42
local BOLT_NEAR = 30      -- м: враг ближе — болтовка в руках неуместна
local BOLT_FAR  = 40      -- м: враг дальше — назад на болтовку
local BOLT_SHOT = 1500    -- мс: выстрел был только что — «выстрелил и на запасной»
local SKILL_LOW, SKILL_TOP = 3500, 17500  -- ранг: новичок (0) … мастер (1), game_relations.ltx

local function is_bolt(wpn)
	return (ini_sys:r_float_ex(wpn:section(), "rpm") or 999) <= BOLT_RPM
end

-- навык 0..1: новичок — 0, мастер и легенда — 1
local function skill(npc)
	local r = npc.character_rank and npc:character_rank() or 0
	return math.max(0, math.min(1, (r - SKILL_LOW) / (SKILL_TOP - SKILL_LOW)))
end

local state = {}  -- [npc_id] = { id = выбранный ствол, since, check }

local function kind_of(wpn)
	local k = ini_sys:r_string_ex(wpn:section(), "kind")
	if k == "w_sniper" and not is_bolt(wpn) then return "w_marksman" end  -- v0.5
	if RANGE[k] then return k end
	local cls = wpn:clsid()
	if IsLauncher and IsLauncher(nil, cls) then return "launcher" end
	if IsSniper(nil, cls) then return is_bolt(wpn) and "w_sniper" or "w_marksman" end
	if IsShotgun(nil, cls) then return "w_shotgun" end
	if IsPistol(nil, cls) then return "w_pistol" end
	return "w_rifle"
end

-- 0..1: насколько класс хорош на дистанции d
local function fit(kind, d)
	local r = RANGE[kind] or RANGE.w_rifle
	if d < r[2] then return r[2] <= r[1] and 1 or math.max(0, (d - r[1]) / (r[2] - r[1])) end
	if d <= r[3] then return 1 end
	if d >= r[4] then return 0 end
	return 1 - (d - r[3]) / (r[4] - r[3])
end

-- патроны не учитываем: у живого сталкера они бесконечны (v0.4), пустой магазин — это перезарядка
local function score(npc, wpn, d)
	local k = kind_of(wpn)
	return fit(k, d) * (POWER[k] or 1)
end

-- ===== ПОСЛЕДНИЙ ДОВОД (v0.3, 21.10 — идея юзера) =====
-- Магазин основного пуст, враг виден и близко, укрыться негде: перезаряжаться на открытом месте —
-- смерть, пистолет достаётся быстрее. Угроза прошла — сразу обратно на основной ствол (он пуст —
-- движок перезарядит). Укрытие рядом есть — пистолет не нужен: перезарядка (уйти за укрытие — дело
-- будущего микрослоя, не этого скрипта).
local SIDEARM_D     = 25    -- м: враг ближе — угроза прямая
local SIDEARM_COVER = 6     -- м: спрятанной от врага ноды нет ближе — «укрыться негде»
local SIDEARM_CALM  = 2500  -- мс: врага не видно столько — угроза прошла
local SIDEARM_FAR   = 35    -- м: враг дальше — угроза прошла

local function find_sidearm(npc)
	local out
	npc:iterate_inventory(function(_, item)
		if not out and IsWeapon(item) and kind_of(item) == "w_pistol" then out = item end
	end, npc)
	return out
end

local function held(o, id) return o and o:parent() and o:parent():id() == id end

-- ===== ДОЗАРЯДКА В ПАУЗЕ (25.10, «перезарядка в укрытии» — юзер: «это уже даже и не смешно») =====
-- Движок перезаряжает, когда магазин ПУСТ — то есть посреди перестрелки и часто на виду. Боец VARKA меняет
-- неполный магазин в паузе: враг известен, но не виден TOPUP_CALM — между ними что-то есть.
-- Команды «перезарядить» из Lua нет: object.reload в set_item → switch движка без этой ветки (NODEFAULT,
-- object_handler_planner.cpp) = краш, как 21.10. Поэтому магазин обнуляется, и движок сам играет перезарядку
-- (патроны у сталкеров бесконечны, v0.4). Но перезаряжает он, только если боец целится (ствол «в покое» —
-- нет): не началась за TOPUP_UNDO — патроны возвращаются, хуже ванили не станет.
local TOPUP_FRAC = 0.5    -- доля магазина: меньше — менять
local TOPUP_CALM = 2000   -- мс: врага не видно столько
local TOPUP_GAP  = 8000   -- мс: не чаще раза на бойца
local TOPUP_UNDO = 5000   -- мс: магазин всё ещё пуст — перезарядка не пошла, вернуть патроны

local function top_up(npc, st, wpn, be, now)
	local p = st.topup_wait
	if p then  -- ждём, пошла ли перезарядка
		local w = level.object_by_id(p.id)
		if not (w and held(w, npc:id())) then st.topup_wait = nil
		elseif (w:get_ammo_in_magazine() or 0) > 0 then
			st.topup_wait = nil
			if varka_trace then varka_trace.emit(0, npc:id(), "wpn_topup_done", { ms = now - p.t }) end
		elseif now - p.t > TOPUP_UNDO then
			st.topup_wait = nil
			w:set_ammo_elapsed(p.m)
			if varka_trace then varka_trace.emit(0, npc:id(), "wpn_topup_undo", { mag = p.m }) end
		end
		return
	end
	if be and npc:see(be) then st.seen_at = now; return end
	if not (be and wpn) or now - (st.seen_at or 0) < TOPUP_CALM or now < (st.topup or 0) then return end
	if kind_of(wpn) == "w_shotgun" or is_bolt(wpn) then return end  -- патрон за патроном: обнулить = долгая набивка
	local size = ini_sys:r_float_ex(wpn:section(), "ammo_mag_size") or 0
	local m = wpn:get_ammo_in_magazine() or 0
	if m == 0 or size <= 1 or m >= size * TOPUP_FRAC then return end
	if npc:wounded() or (xrs_kill_wounded and xrs_kill_wounded.is_under_kill_wounded(npc)) then return end
	st.topup, st.topup_wait = now + TOPUP_GAP, { id = wpn:id(), m = m, t = now }
	wpn:set_ammo_elapsed(0)
	if varka_trace then varka_trace.emit(0, npc:id(), "wpn_topup", { mag = m, size = size, sec = wpn:section() }) end
end

local function choose(npc, cur_wpn, flags)
	if varka_vanilla.is(npc) then return end  -- 25.10: отряд «чистая ваниль»
	if not (npc and npc:alive()) then return end
	local id, now = npc:id(), time_global()
	local st = state[id]
	if not st then st = { since = 0, check = 0 }; state[id] = st end

	-- v0.5: выстрел из болтовки замечаем по магазину (колбэк выстрела у бойца один, его держит varka_match)
	local held_wpn = cur_wpn and IsWeapon(cur_wpn) and cur_wpn or nil
	if held_wpn and is_bolt(held_wpn) then
		local m = held_wpn:get_ammo_in_magazine() or 0
		if st.mag_id == held_wpn:id() and m < st.mag then st.shot, st.check = now, 0 end
		st.mag_id, st.mag = held_wpn:id(), m
	end

	-- кэш: пока свежо — отвечаем тем же
	if now < st.check and st.id then
		local o = level.object_by_id(st.id)
		if held(o, id) then flags.gun_id = st.id end
		return
	end
	st.check = now + CACHE_MS

	local be = npc:best_enemy()
	local cur = cur_wpn and IsWeapon(cur_wpn) and cur_wpn or nil
	local d = be and npc:position():distance_to(be:position())
	top_up(npc, st, cur, be, now)  -- 25.10: неполный магазин — сменить в паузе
	local force = false  -- сменить без выдержки SWITCH_HOLD

	-- последний довод: держим пистолет, пока угроза не прошла
	if st.sidearm then
		local o = level.object_by_id(st.sidearm)
		if be and npc:see(be) then st.seen = now end
		local calm = not be or d > SIDEARM_FAR or now - st.seen > SIDEARM_CALM
		if held(o, id) and not calm then
			st.id = st.sidearm
			flags.gun_id = st.id
			return
		end
		if varka_trace then
			varka_trace.emit(0, id, "wpn_sidearm_end", { why = calm and "calm" or "lost", d = d or -1 })
		end
		st.sidearm, force = nil, true
	elseif be and cur and kind_of(cur) ~= "w_pistol" and (cur:get_ammo_in_magazine() or 0) == 0
		and d < SIDEARM_D and npc:see(be) then
		local cover = varka_eyes and varka_eyes.hidden_spot(npc:level_vertex_id(), be:position(), SIDEARM_COVER)
		local p = not cover and find_sidearm(npc)
		if p then
			st.sidearm, st.seen, st.since = p:id(), now, now
			st.id = p:id()
			flags.gun_id = st.id
			if varka_trace then
				varka_trace.emit(0, id, "wpn_sidearm", { from = cur:section(), to = p:section(), d = d })
			end
			return
		end
	end

	-- v0.5: болтовка вблизи. Запасной держим, пока враг не отойдёт дальше BOLT_FAR.
	if st.backup then
		local o = level.object_by_id(st.backup)
		if be and d < BOLT_FAR and held(o, id) then
			st.id = st.backup
			flags.gun_id = st.id
			return
		end
		st.backup, force = nil, true
	elseif be and cur and is_bolt(cur) and d < BOLT_NEAR then
		local pre = d < BOLT_NEAR * (1 - skill(npc))        -- заранее: новичок — сразу, мастер — никогда
		local shot = st.shot and now - st.shot < BOLT_SHOT  -- выстрелил — и на запасной, не передёргивая
		if pre or shot then
			local alt, alt_s = nil, -1
			npc:iterate_inventory(function(_, item)
				if IsWeapon(item) and not IsMelee(item) and not IsGrenade(item) and not is_bolt(item) then
					local s = score(npc, item, d)
					if s > alt_s then alt, alt_s = item, s end
				end
			end, npc)
			if alt then  -- запасного нет — воюем болтовкой
				st.backup, st.since, st.shot = alt:id(), now, nil
				st.id = alt:id()
				flags.gun_id = st.id
				if varka_trace then
					varka_trace.emit(0, id, "wpn_switch", { from = cur:section(), to = alt:section(), d = d,
						s_from = -1, s_to = alt_s, why = pre and "bolt_pre" or "bolt_shot", skill = skill(npc) })
				end
				return
			end
		end
	end

	if not be then
		-- без врага не дёргаемся — кроме пистолета в руках: после боя боец возвращается к
		-- основному стволу (пустой — движок перезарядит)
		if not (cur and kind_of(cur) == "w_pistol") then
			st.id = cur and cur:id() or st.id
			if st.id then flags.gun_id = st.id end
			return
		end
		d, force = 20, true
	end

	local best, best_s = nil, -1
	npc:iterate_inventory(function(_, item)
		if IsWeapon(item) and not IsMelee(item) and not IsGrenade(item) then
			local s = score(npc, item, d)
			if s > best_s then best, best_s = item, s end
		end
	end, npc)
	if not best then return end

	local cur_s = cur and score(npc, cur, d) or -1
	local keep = cur and best:id() ~= cur:id()
		and (best_s < cur_s + MARGIN or (now - st.since < SWITCH_HOLD and not force))
	local pick = keep and cur or best
	if not cur or pick:id() ~= cur:id() then
		st.since = now
		if varka_trace then
			varka_trace.emit(0, id, "wpn_switch", { from = cur and cur:section() or "", to = pick:section(),
				d = d, s_from = cur_s, s_to = score(npc, pick, d) })
		end
	end
	st.id = pick:id()
	flags.gun_id = st.id
end

local function npc_death(npc)
	if npc then state[npc:id()] = nil end
end

function on_game_start()
	RegisterScriptCallback("npc_on_choose_weapon", choose)
	RegisterScriptCallback("npc_on_death_callback", npc_death)
end
