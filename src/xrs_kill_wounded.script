--[[
	scheme_type: generic
	author: Alundaio
	modified_by: VARKA (20.10.2026) — добивание срывалось: в упор таймер сбрасывался каждый тик,
	             а выбор точки пропускал ноды ближе 3 м (квадрат расстояния сравнивался с метрами).
	             Теперь: палач держит дистанцию >= min_distance, слишком близко — отходит, таймер не теряет,
	             стреляет только стоя на своей точке. Все правки помечены "VARKA".
--]]


evaid = 188112
actid = 188112
----------------------------------------------------------------------------------------------------------------------
hostage_list = {}
local ini = ini_file("ai_tweaks\\xrs_kill_wounded.ltx")
local Enable = ini:r_bool_ex("settings","enable",false)
function is_enabled() return Enable == true end  -- VARKA 23.10: varka_survive спрашивает, есть ли действие 188112
local ActorKillWoundedChance = ini:r_float_ex("settings","actor_cause_surrender_chance") or 0.25
local ActorKillWoundedMaxDist = ini:r_float_ex("settings","actor_cause_surrender_max_dist") or 7
local MinDistanceRunState = ini:r_float_ex("settings","state_run_min_distance") or 8
local MinDistance = ini:r_float_ex("settings","min_distance") or 3
local MaxDistance = ini:r_float_ex("settings","max_distance") or 5
local MinVectorRotateY = ini:r_float_ex("settings","min_vector_rotate_y") or 1
local MaxVectorRotateY = ini:r_float_ex("settings","max_vector_rotate_y") or 95
local MinTriggerTimer = ini:r_float_ex("settings","min_timer","float") or 3000
local MaxTriggerTimer = ini:r_float_ex("settings","max_timer","float") or 5000
local SurrenderMinTriggerTimer = ini:r_float_ex("settings","surrender_min_timer") or 5000
local SurrenderMaxTriggerTimer = ini:r_float_ex("settings","surrender_max_timer") or 5000
-- VARKA: казнь быстрее — палач слишком долго смотрит перед выстрелом (юзер 20.10: ×0.6; 21.10: «слишком
-- много навешивают» — замер: от прихода к жертве до выстрела медиана 6 с). ×0.3: обычная 0.45–1.35 с,
-- с анимацией пленного 2.4–3 с.
local VARKA_TIMER_SCALE = 0.3
local VAN_TIMER = { MinTriggerTimer, MaxTriggerTimer, SurrenderMinTriggerTimer, SurrenderMaxTriggerTimer }  -- 25.10: для «чистой ванили»
MinTriggerTimer, MaxTriggerTimer = MinTriggerTimer * VARKA_TIMER_SCALE, MaxTriggerTimer * VARKA_TIMER_SCALE
SurrenderMinTriggerTimer = SurrenderMinTriggerTimer * VARKA_TIMER_SCALE
SurrenderMaxTriggerTimer = SurrenderMaxTriggerTimer * VARKA_TIMER_SCALE
local KillWoundedSoundChance = ini:r_float_ex("settings","chance_to_play_sound") or 0.25
local SurrenderChance = ini:r_float_ex("settings","chance_to_play_surrender") or 0.25
local CauseSurrenderCommunities = parse_list(ini,"settings","cause_surrender_communities",true)
ini = nil

local PICK_TRIES = 8 -- VARKA: сколько случайных направлений пробовать, прежде чем просто отступить

-- VARKA (21.10): точка палача годится, только если с неё видно тело — луч по статике от глаз до груди
-- лежачего. Бой 21.10: жертва в ложбине, луч с точки палача упирался за метр до тела; палач 33 с стоял
-- в 4 м — «дошёл до кольца» каждый тик брал свою же слепую точку, see() = нет, сброс, по кругу.
-- Жертва вылечилась, встала и выстрелила первой.
local RQT_STATIC = 2    -- collide::rqtStatic
local EYE_H      = 1.6  -- глаза стоящего над нодой, м
local GUN_H      = 1.35 -- ствол стоящего над нодой (у плеча), м
local MUZZLE     = 0.5  -- срез ствола впереди кисти, м
local BLOCK_MS   = 700  -- мс: ствол упёрся дольше — точка негодная, ищем другую
local FF_MS      = 2000 -- VARKA 24.10: «свой на линии» дольше — сменить точку (бой #28: палач Монолита 34 с стоял в
                        -- rx_dont_shoot, напарник в 1.5 м стоял на линии и сам был заблокирован им же — взаимная блокировка)
local rp_kw

-- отрезок свободен по статике (упор не раньше 0.3 м до конца)
local function line_clear(from, to)
	if not rp_kw then
		rp_kw = ray_pick()
		rp_kw:set_flags(RQT_STATIC)
	end
	local dir = vector():set(to):sub(from)
	local d = dir:magnitude()
	if d < 0.5 then return true end
	dir:normalize()
	rp_kw:set_position(from)
	rp_kw:set_direction(dir)
	rp_kw:set_range(d)
	return not rp_kw:query() or rp_kw:get_distance() >= d - 0.3
end

local function chest_of(vo)
	return utils_obj.safe_bone_pos(vo, "bip01_spine1")
end

-- с точки pos (позиция ноды) до груди лежачего чисто и глазам, и стволу.
-- VARKA 21.10 (снимок юзера: палач у автобуса высадил магазин в бампер): глаза над бампером, ствол — в него.
local function body_in_sight(pos, vo)
	local chest = chest_of(vo)
	return line_clear(vector():set(pos.x, pos.y + EYE_H, pos.z), chest)
		and line_clear(vector():set(pos.x, pos.y + GUN_H, pos.z), chest)
end

-- живая линия ствола: от кисти (+ срез) до груди лежачего. npc:see (глаза движка) видит сквозь окна и
-- щели — стрелять разрешает, а пуля бьёт в железо. Не local: им же пользуется varka_finish (ренегаты).
function muzzle_clear(npc, vo)
	local chest = chest_of(vo)
	local hand = utils_obj.safe_bone_pos(npc, "bip01_r_hand")
	local dir = vector():set(chest):sub(hand)
	local d = dir:magnitude()
	if d < 1 then return true end
	return line_clear(vector():set(hand):add(dir:mul(MUZZLE / d)), chest)
end

